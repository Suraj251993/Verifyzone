@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model OrgCheck.ViewModels.UploadSummaryViewModel
@{
    Layout = "~/Views/Shared/_ExZoneLayout.cshtml";
}
<link rel="stylesheet" href="~/assets/css/bulk.css">
<link rel="stylesheet" href="/assets/css/verification-request.css">
<link rel="stylesheet" href="/assets/css/exit-details.css">
<script src="~/assets/js/echarts.min.js"></script>
<link rel="stylesheet" href="/assets/css/access-denied.css">

<div class="breadcrumbs" style="padding: 10px 0px 20px 5px">
    <a href="/Customer/Index">
        <i class="ri-home-8-line" style="color: var(--purple-color)"></i>
    </a> <i class="ri-arrow-right-s-line"
            style="color: var(--purple-color)"></i> <span style="color: var(--purple-color);font-size: 14px;">Ex-Zone</span> 
            <i class="ri-arrow-right-s-line" style="color: var(--purple-color)"></i> <span style="font-size: 14px;">Bulk upload</span>
</div>
@if (ViewBag.AccessLevel == 1 || ViewBag.AccessLevel == 3)
{
    <div class="bulk-upload-card mb-3 shadow-sm">
        <h5 class=" bulk-table-heading mb-4">Upload your Ex-employee details in bulk</h5>

        <div class="row align-items-center">
            <div class="col-md-2"></div>
            <div class="col-md-8 mb-2">
                <div class="upload-component">
                    <label for="bulkFileUpload" id="fileDropZone"
                           class="drop-area d-flex flex-column justify-content-center align-items-center position-relative"
                           style="min-height: 200px; padding: 20px;  border-radius: 10px;">
                        <input type="hidden" id="flid" />
                        <div id="fileContent" class="d-flex flex-column justify-content-center align-items-center">
                            <p class="file-prompt mb-1 pt-4">
                                <i class="ri-upload-cloud-2-line fs-2"></i>
                            </p>
                            <p class="text-muted mb-1">
                                Drag & Drop your
                                file here
                            </p>
                            <p class="text-muted mb-3">
                                or Click to
                                Browse
                            </p>
                        </div>

                        <!-- Progress Bar -->
                        <div class="custom-upload-progress w-50 progress" style="height: 20px; display: none;">
                            <div class="custom-progress-bar progress-bar progress-bar-striped" style="width: 100%;
                                            margin-top: -10px;
                                            height: 30px;
                                            border-radius: 5px;
                                            background-color: rgb(92, 36, 154);
                                            transition: width 0.3s;">
                            </div>
                        </div>

                        <!-- File Name Display inside drag & drop at bottom -->
                        <div id="uploadedFileName" class="text-center text-muted"></div>

                    </label>

                    <input type="file" id="bulkFileUpload" style="display: none;" accept=".csv" />

                    <div class="w-100 d-flex justify-content-center mt-4">
                        <button class="btn-submit" id="btnupload" name="btnupload">
                            <div class="original">Upload File</div>
                            <div class="letters">
                                <span>U</span><span>p</span><span>l</span><span>o</span><span>a</span><span>d</span>
                                <span class="ms-1"></span>
                                <span>F</span><span>i</span><span>l</span><span>e</span>
                            </div>
                        </button>
                    </div>
                </div>
                <div class="modal fade" id="uploadPop" data-bs-backdrop="static" data-bs-keyboard="false"
                     tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header border-0">
                                <h1 class="modal-title bulk-table-heading fs-5" id="staticBackdropLabel">
                                    Upload file
                                    summary
                                </h1>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div id="main" style="width: 100%; height: 350px; padding:0; margin:0;"></div>
                                <div class="card p-0 mt-3 mb-4 border-0">
                                    <table>
                                        <thead style="background: #f8ece2">
                                            <tr>
                                                <th class="sortable">
                                                    Employee name <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                                                </th>
                                                <th class="sortable">
                                                    Employee code <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                                                </th>
                                                <th class="sortable">
                                                    Invalid reason <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                                                </th>
                                            </tr>
                                        </thead>

                                        <tbody class="tbody-tr">
                                            @* <tr class="selected">
                                                <td></td>
                                                <td>#826</td>
                                                <td style="color: red;">*Employee name is empty</td>
                                            </tr>
                                            <tr class="selected">
                                                <td>Testing</td>
                                                <td></td>
                                                <td style="color: red;">*Employee code is empty</td>
                                            </tr>
                                            <tr class="selected">
                                                <td>Testing</td>
                                                <td>#826</td>
                                                <td style="color: red;">*Designation is empty</td>
                                            </tr> *@
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="modal-footer border-0 justify-content-center">
                                <button class="verify-button-approve" id="btnapprove">
                                    <i class="ri-upload-cloud-2-line"></i>
                                    Upload
                                </button>
                                <button class="verify-button-reject" id="btnreject">
                                    <i class="ri-close-line"></i>
                                    Reject
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-2"></div>
        </div>
    </div>
    <div class="content pb-0">
    <div class="d-flex justify-content-between mb-2">
        <h5 class="bulk-table-heading">Upload History</h5>
        <button class="btn-submit" id="downloadtemplate" name="downloadtemplate">
            <i class="original bulk-icon ri-download-2-line me-2"></i>
            <div class="letters">
                <span>D</span>
                <span>o</span>
                <span>w</span>
                <span>n</span>
                <span>l</span>
                <span>o</span>
                <span>a</span>
                <span>d</span>
            </div>
            <i class="ri-download-2-line me-2"></i>
        </button>

    </div>

    <div class="card p-0 mt-3 mb-4 border-0">
        <table>
            <thead style="background: #f8ece2">
                <tr>
                    @* <th class="sortable">S.no <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i></th> *@
                    <th class="sortable">File name <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i></th>
                    <th class="sortable">Uploaded date <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i></th>
                    <th class="sortable">Status <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i></th>
                    <th class="sortable">Valid records <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i></th>
                    <th class="sortable">Invalid records <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i></th>
                    <th class="sortable">Total records <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i></th>
                </tr>
            </thead>
            <tbody class="tbody-tr tbodyTr" id="tableIdx">
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-end w-100">
        <nav aria-label="Page navigation example">
            <ul class="pagination-custom">
                <li class="page-item-custom">
                    <a class="page-link-custom prev" href="#" aria-label="Previous">
                        <span aria-hidden="true"><i class="ri-arrow-left-s-line"></i></span>
                    </a>
                </li>

                <li class="page-item-custom active">
                    <a class="page-link-custom" href="#">1</a>
                </li>

                <li class="page-item-custom">
                    <a class="page-link-custom next" href="#" aria-label="Next">
                        <span aria-hidden="true"><i class="ri-arrow-right-s-line"></i></span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script src="~/assets/js/sort.js" asp-append-version="true"></script>
<script src="~/assets/js/upload.js" asp-append-version="true"></script>
<script src="~/assets/js/canvasjs.min.js"></script>
<script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
    var approveurl = '@Url.Action("ApproveorRejectFile", "Customer")';
    var bindurl = '@Url.Action("GetLatestUploads", "Customer")';
    var updloadurl = '@Url.Action("EmployeeUpload", "Customer")';
    var templateurl = '@Url.Action("DownloadTemplate", "Customer")';
    var balanceurl = '@Url.Action("GetCustomerBalance", "Customer")';
    document.getElementById("btnapprove").addEventListener("click", function() { ApprovedorRejectedFile("Approve", approveurl); }, false);
    document.getElementById("btnreject").addEventListener("click", function() { ApprovedorRejectedFile("Reject", approveurl); }, false);
    document.getElementById("btnupload").addEventListener("click", function() { UploadFile(uploadurl); }, false);
    document.getElementById("btnupload").addEventListener("click", function() { DownloadTemplate(templateurl); }, false);
    
    $(document).ready(function () {
        ShowBalance(balanceurl);
        BindFileUploads(bindurl);

        // When modal is fully open
        document.getElementById('uploadPop')
            .addEventListener('shown.bs.modal', function () {
                setTimeout(() => {
                    DrawChart();
                }, 5); // short delay ensures perfect size
            });

        // Responsive
        window.addEventListener("resize", function () {
            if (myChart) myChart.resize();
        });
    });

    document.addEventListener("click", function (e) {
        const link = e.target.closest(".page-link-custom");
        if (!link) return;

        e.preventDefault();

        const page = parseInt(link.dataset.page);
        if (!isNaN(page)) {
            changePage(page);
        }
    });
</script>
}
else
{
    <div class="container">
        <div class="container-access">
            <img src="/assets/img/403 Access Denied.png" alt="">
            <h5 class="access-header-first-403">Oops !!!</h5>
            <h6 class="access-header-403">Access denied</h6>
            <p class="access-para-403">You are not authorized to view this page. <br> Please return to the homepage or contact support.</p>
            <a href="/Home/Landing">
                <button class="access-back-btn">Go back</button>
            </a>
        </div>
    </div>
}