<script src="~/assets/js/sort.js" asp-append-version="true"></script>
<script src="~/assets/js/canvasjs.min.js"></script>
<script src="~/assets/js/pages/viewemployee.js?ver=2" asp-append-version="true"></script>
<script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
    var editurl = '@Url.Action("ExportEmployees", "Customer")';
    var bindurl = '@Url.Action("GetAllEmployees", "Customer")';
    var excludeurl = '@Url.Action("ExcludeEmployee", "Customer")';
    document.getElementById("export").addEventListener("click", function() { exportEmployees(editurl); }, false);
    BindEmployees(bindurl);

    document.addEventListener("click", function (e) {
        const link = e.target.closest(".page-link-custom");
        if (!link) return;

        e.preventDefault();

        const page = parseInt(link.dataset.page);
        if (!isNaN(page)) {
            changePage(page);
        }
    });
    document.addEventListener("click", function (e) {
        const btn = e.target.closest(".action-btn");
        if (!btn) return;

        const id = btn.dataset.id;

        excludeemployee(id, excludeurl);
    });
</script>