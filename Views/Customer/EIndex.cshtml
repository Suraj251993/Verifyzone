@{
    Layout = "";
}
@model OrgCheck.ViewModels.CustomerDashboardCount;
<style>:root{--purple-color:#5c249a;--light-purple-color:#340c62;}</style>
<link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
<link href="/assets/remix/fonts/remixicon.css" rel="stylesheet">
<link rel="stylesheet" href="~/assets/css/dash.css" asp-append-version="true">
@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-checkboxes-jquery/datatables.checkboxes.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/toastr/toastr.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/animate-css/animate.dist.css">
}

@section VendorScripts {
    <script src="~/vendor/libs/chartjs/chartjs.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
    <script src="~/vendor/libs/toastr/toastr.dist.js"></script>
    <script src="~/js/common.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/app-logistics-dashboard.dist.css" />
}

@* ************** Content ************** *@
<div class="dashboard-content">
    <div class="exz-page-head">
        <h1>Education dashboard</h1>
        <p>Track student verification requests and re-verification progress.</p>
    </div>

    <div class="exz-kpi-row">
        <div class="exz-kpi-card">
            <div class="exz-kpi-icon"><i class="ri-checkbox-circle-line"></i></div>
            <div class="exz-kpi-body">
                <h2>@Model.CompletedCount</h2>
                <div class="exz-kpi-label">Re-verification completed</div>
                <div class="exz-kpi-sub">On @Model.Month, @Model.Year</div>
            </div>
        </div>
        <div class="exz-kpi-card" style="cursor: pointer;" onclick="window.location = '/Customer/StudentApproval';">
            <div class="exz-kpi-icon"><i class="ri-user-follow-line"></i></div>
            <div class="exz-kpi-body">
                <h2>@Model.ApprovalCount</h2>
                <div class="exz-kpi-label">Student re-verify</div>
                <div class="exz-kpi-sub">As of now</div>
            </div>
        </div>
        <div class="exz-kpi-card" style="cursor: pointer;" onclick="window.location = '/Customer/StudentInfoRequest';">
            <div class="exz-kpi-icon"><i class="ri-notification-3-line"></i></div>
            <div class="exz-kpi-body">
                <h2>@Model.RequestCount</h2>
                <div class="exz-kpi-label">Student request</div>
                <div class="exz-kpi-sub">As of now</div>
            </div>
        </div>
    </div>
</div>
<!--/ Card Border Shadow -->

<script>
    $(document).ready(function () {
        var balanceurl = '@Url.Action("GetCustomerBalance", "Customer")';
        ShowBalance(balanceurl);
        $('#loading').hide();
    });
</script>
