                                                    Last approved
                                                    date
                                                </label>
                                                <i class="ri-contacts-line userIcon"></i>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <!-- Replace "Next" with a Submit button -->
                                <div class="col-md-12 text-end d-flex justify-content-end gap-2 p-2">
                                    <button class="btn-closes" id="btnexclude">
                                        <div class="original">Exclude</div>
                                        <div class="letters">
                                            <span>E</span>
                                            <span>x</span>
                                            <span>c</span>
                                            <span>l</span>
                                            <span>u</span>
                                            <span>d</span>
                                            <span>e</span>
                                        </div>
                                    </button>&nbsp;&nbsp;
                                    <button class="btn-submit submitbutton" type="button" id="next" name="next"
                                            value="Next">
