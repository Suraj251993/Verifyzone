                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="inputContainer">
                                                @Html.TextBoxFor(model => model.Reportingto, new { @class = "input-container", @type = "text", @placeholder = "Reporting to", @autocomplete = "off" })
