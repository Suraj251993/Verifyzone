                                                    *Please
                                                    enter Work location
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="inputContainer">
                                                @Html.TextBoxFor(model => model.Jobtype, new { @class = "input-details input-container", @type = "text", @placeholder = "Job type (Permanent/Contract/Others)", @autocomplete = "off" })
                                                <label class="usernameLabel">
                                                    Job
                                                    type
                                                    (Permanent/Contract/Other)
                                                </label>
                                                <i class="ri-user-settings-line userIcon"></i>                                                
                                            </div>
                                        </div>
                                        <div class="col-md-6">
