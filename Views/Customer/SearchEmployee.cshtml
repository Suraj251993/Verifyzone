@{
    Layout = "~/Views/Shared/_ExZoneLayout.cshtml";
}
<link rel="stylesheet" href="/assets/css/search-candidate.css">
<link rel="stylesheet" href="/assets/css/verification-request.css">
<link rel="stylesheet" href="/assets/css/bulk.css">
<link rel="stylesheet" href="/assets/css/exit-details.css">
<link rel="stylesheet" href="/assets/css/new-request.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<link rel="stylesheet" href="/assets/css/access-denied.css">

@model OrgCheck.ViewModels.EmployeeViewModel
<div class="breadcrumbs" style="padding: 10px 0px 20px 5px">
    <a href="/Customer/Index">
        <i class="ri-home-8-line" style="color: var(--purple-color)"></i>
    </a> <i class="ri-arrow-right-s-line"
            style="color: var(--purple-color)"></i> <span style="color: var(--purple-color);font-size: 14px;">Ex-Zone</span> 
            <i class="ri-arrow-right-s-line" style="color: var(--purple-color)"></i> <span style="font-size: 14px;">Search Ex-employee</span>
</div>
@if (ViewBag.AccessLevel == 1 || ViewBag.AccessLevel == 3)
{
    <div class="content">

    <h5 class="bulk-table-heading mb-4">Search Ex-employee</h5>

    <div class="d-flex justify-content-center gap-3">
        <div class="search-box">
            <input type="text" placeholder="Enter employee code..." id="txtsearchempcode" autocomplete="off" />
            <i class="ri-search-line"></i>
        </div>
        <button class="btn-submit" id="GetEmp">
            <div class="original">Get Data</div>
            <div class="letters">
                <span>G</span>
                <span>e</span>
                <span>t</span>
                <span class="ms-1"></span>
                <span>D</span>
                <span>a</span>
                <span>t</span>
                <span>a</span>
            </div>
        </button>
    </div>

    <div class="text-center mt-5" id="divnorecord" style="display: none;">
        <img src="/assets/img/no-data-found-img.jpg" alt="no-record-found" style="height: 200px;">
        <h6 class="no-data-found-text">No record found</h6>
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="">
                <div class="cardz px-0 pt-4 pb-0 mt-3 mb-3">
                    <form id="divForm">
                            <!-- Progressbar -->
                            <ul id="progressbar">
                                <li class="active" id="account">
                                    <i class="ri-user-2-fill"></i>
                                    <strong>Basic Details</strong>
                                </li>
                                <li id="personal">
                                    <i class="ri-question-answer-line"></i>
                                    <strong>Add Attributes</strong>
                                </li>
                                <li id="payment">
                                    <i class="ri-add-box-line"></i>
                                    <strong>Alert the employers about this candidate</strong>
                                </li>
                            </ul>
                            <br>

                            <!-- Step 1 -->
                            <fieldset>
                                <div class="form-card">
                                    <div class="row">
                                        <div class="col-7">
                                        </div>
                                        <div class="col-5">
                                            <h2 class="steps">Step 1 - 2</h2>
                                        </div>
                                        @Html.HiddenFor(model => model.Mode)
                                        @Html.HiddenFor(model => model.SearchId)
                                        @Html.HiddenFor(Model => Model.Id)
                                        <div class="col-md-6">
                                            <div class="inputContainer">
                                                @Html.TextBoxFor(model => model.Name, new { @class = "input-details input-container", @type = "text", @placeholder = "Employee name", @autocomplete = "off" })
                                                <label class="usernameLabel">
                                                    Employee
                                                    name
                                                </label>
                                                <i class="ri-user-6-line userIcon"></i>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="inputContainer">
                                                @Html.TextBoxFor(model => model.Employeecode, new { @class = "input-details input-container", @type = "text", @placeholder = "Employee code", @autocomplete = "off" })
                                                <label class="usernameLabel">Employee code</label>
                                                <i class="ri-user-settings-line userIcon"></i>                                                
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="inputContainer">
                                                @Html.TextBoxFor(model => model.Designation, new { @class = "input-details input-container", @type = "text", @placeholder = "Designation", @autocomplete = "off" })
                                                <label class="usernameLabel">Designation</label>
                                                <i class="ri-bar-chart-grouped-line userIcon"></i>                                                
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="dateInputContainer">
                                                @Html.TextBoxFor(model => model.Fromdate, new { @class = "input-details fromDate", @type = "text", @placeholder = "From date", @autocomplete = "off" })
                                                <div class="label-container">
                                                    <i class="ri-calendar-line label-icon"></i>
                                                    <label class="dateLabel" for="fromDate">
                                                        From
                                                        date
                                                    </label>
                                                </div>
                                                <i class="ri-calendar-line dateIcon"></i>                                                
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="dateInputContainer">
                                                @Html.TextBoxFor(model => model.Todate, new { @class = "input-details toDate", @type = "text", @placeholder = "To date", @autocomplete = "off" })
                                                <div class="label-container">
                                                    <i class="ri-calendar-2-line label-icon"></i>
                                                    <label class="dateLabel" for="toDate">
                                                        To
                                                        date
                                                    </label>
                                                </div>
                                                <i class="ri-calendar-2-line dateIcon"></i>                                                
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="inputContainer">
                                                @Html.TextBoxFor(model => model.Reasonforleaving, new { @class = "input-details input-container", @type = "text", @placeholder = "Reason for leaving", @autocomplete = "off" })
                                                <label class="usernameLabel">Reason for leaving</label>
                                                <i class="ri-map-pin-user-line userIcon"></i>                                                
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="inputContainer reasonContainer"
                                                 id="inputContainer" style="position: relative;">
                                                <input class="input-container" required="required" autocomplete="off"
                                                       placeholder="Type of exit"
                                                       type="text" readonly>
                                                <label class="usernameLabel">
                                                    Type
                                                    of exit
                                                </label>
                                                <i class="ri-run-line userIcon"></i>
                                                <!-- Chevron Icon -->
                                                <svg viewBox="0 0 320 512" class="chevronIcon"
                                                     id="chevronIcon">
                                                    <path d="M143 352.3L7 216.3c-9.4-9.4-9.4-24.6 0-33.9l22.6-22.6c9.4-9.4
                                                                24.6-9.4 33.9 0L160 239.4l96.5-96.5c9.4-9.4
                                                                24.6-9.4 33.9 0l22.6 22.6c9.4 9.4
                                                                9.4 24.6 0 33.9l-136 136c-9.4 9.4-24.6
                                                                9.4-33.9 0z" />
                                                </svg>
                                                <!-- Dropdown Menu -->
                                                <div id="dropdownExitType" class="newinput-dropdown-menu"></div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="inputContainer">
                                                @Html.TextBoxFor(model => model.Location, new { @class = "input-details input-container", @type = "text", @placeholder = "Work location", @autocomplete = "off" })
