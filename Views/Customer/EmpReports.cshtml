@{
    Layout = "~/Views/Shared/_VZoneLayout.cshtml";
}
<link rel="stylesheet" href="/assets/css/search-candidate.css">
<link rel="stylesheet" href="/assets/css/verification-request.css">
<link rel="stylesheet" href="/assets/css/bulk.css">
<link rel="stylesheet" href="/assets/css/exit-details.css">
<link rel="stylesheet" href="/assets/css/new-request.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/js/common.js" asp-append-version="true"></script>
<link rel="stylesheet" href="/assets/css/access-denied.css">

<div class="breadcrumbs" style="padding: 10px 0px 20px 5px">
    <a href="/Customer/VIndex">
        <i class="ri-home-8-line" style="color: var(--purple-color)"></i>
    </a> <i class="ri-arrow-right-s-line"
            style="color: var(--purple-color)"></i> 
            <span style="color: var(--purple-color);font-size: 14px;">V-Zone</span> 
            <i class="ri-arrow-right-s-line"style="color: var(--purple-color)"></i> <span style="font-size: 14px;">Employment verification reports</span>
</div>
@if (ViewBag.AccessLevel == 2 || ViewBag.AccessLevel == 3)
{
    <div class="content">

    <h5 class="bulk-table-heading mb-4 mt-3">Employment verification reports</h5>

    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="inputContainer reasonContainer" id="inputContainer" style="position: relative;">
                <input required="required" autocomplete="off" placeholder="Choose the month" type="text" class="input-details input-container" readonly id="exitInput">
                <label class="usernameLabel">Choose the month</label>
                <i class="ri-run-line userIcon"></i>
                <!-- Chevron Icon -->
                <svg viewBox="0 0 320 512" class="chevronIcon" id="chevronIcon">
                    <path d="M143 352.3L7 216.3c-9.4-9.4-9.4-24.6 0-33.9l22.6-22.6c9.4-9.4
                                                    24.6-9.4 33.9 0L160 239.4l96.5-96.5c9.4-9.4
                                                    24.6-9.4 33.9 0l22.6 22.6c9.4 9.4
                                                    9.4 24.6 0 33.9l-136 136c-9.4 9.4-24.6
                                                    9.4-33.9 0z" />
                </svg>
                <!-- Dropdown Menu -->
                <div id="month" class="newinput-dropdown-menu"></div>
                <span class="validationMessage" style="display:none;">
                    *This field is required
                </span>
            </div>
        </div>
        <div class="col-md-4">            
            <div class="inputContainer reasonContainer" id="inputContainer2" style="position: relative;">
                    <input required="required" autocomplete="off" placeholder="Choose the year" type="text" class="input-details input-container" readonly id="exitInput">
                    <label class="usernameLabel">Choose the year</label>
                    <i class="ri-run-line userIcon"></i>
                    <!-- Chevron Icon -->
                    <svg viewBox="0 0 320 512" class="chevronIcon" id="chevronIcon">
                        <path d="M143 352.3L7 216.3c-9.4-9.4-9.4-24.6 0-33.9l22.6-22.6c9.4-9.4
                                                    24.6-9.4 33.9 0L160 239.4l96.5-96.5c9.4-9.4
                                                    24.6-9.4 33.9 0l22.6 22.6c9.4 9.4
                                                    9.4 24.6 0 33.9l-136 136c-9.4 9.4-24.6
                                                    9.4-33.9 0z" />
                    </svg>
                    <!-- Dropdown Menu -->
                    <div id="year" class="newinput-dropdown-menu"></div>
                    <span class="validationMessage" style="display:none;">
                        *This field is required
                    </span>
                </div>            
        </div>
    </div>
    <div class="d-flex justify-content-center">
        <button class="btn-submit" id="get">
            <div class="original">Search</div>
            <div class="letters">
                <span>S</span>
                <span>e</span>
                <span>a</span>
                <span>r</span>
                <span>c</span>
                <span>h</span>
            </div>
        </button>
    </div>


    <div class="card p-0 mt-4 mb-4 border-0">
        <table>
            <thead style="background: #f8ece2">
                <tr>
                    <th class="sortable">
                        Employee code <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Search result <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Report generated by <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Report generated on <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Client name <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                </tr>
            </thead>

            <tbody class="tbody-tr tbodyTr" id="tableIdx">            
            </tbody>
        </table>
        <div class="text-center border-bottom" id="divnorecord" style="display: none;">
            <img src="~/assets/img/no-data-found-img.jpg" alt="no-record-found" style="height: 200px;">
            <h6 class="no-data-found-text">No record found</h6>
        </div>
    </div>

</div>
}
else
{
    <div class="container">
        <div class="container-access">
            <img src="/assets/img/403 Access Denied.png" alt="">
            <h5 class="access-header-first-403">Oops !!!</h5>
            <h6 class="access-header-403">Access denied</h6>
            <p class="access-para-403">You are not authorized to view this page. <br> Please return to the homepage or contact support.</p>
            <a href="/Home/Landing">
                <button class="access-back-btn">Go back</button>
            </a>
        </div>
    </div>
}

<script src="/assets/js/jquery-3.2.1.min.js" asp-append-version="true"></script>
<script src="/assets/js/sort.js"></script>
<script src="/assets/js/canvasjs.min.js"></script>
<script src="/assets/js/pages/empreports.js?ver=2" asp-append-version="true"></script>
<script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
    document.addEventListener('DOMContentLoaded', function () {
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        [...tooltipTriggerList].forEach(el => new bootstrap.Tooltip(el));
    });
    $(document).ready(function () {
        var geturl = '@Url.Action("GetEmployeeReports", "Customer")';
        var balanceurl = '@Url.Action("GetCustomerBalance", "Customer")';
        ShowBalance(balanceurl);
        BindMonthDropdown();
        BindYearDropdown();
    
        const button = document.querySelector("#get");
        button.addEventListener("click", () => {
            if (selectedmonth == '' || selectedyear == '') {
                showErrorMessage('Both fields are required to search');
                return;
            }
            getData(geturl);
        });

        const drpmonth = document.getElementById('month');
        const drpyear = document.getElementById('year');
        drpmonth.addEventListener("change", () => {
            if (selectedmonth == '' || selectedyear == '') {
                return;
            }
            getData(geturl);
        });
        drpyear.addEventListener("change", () => {
            if (selectedmonth == '' || selectedyear == '') {
                return;
            }
            getData(geturl);
        });    
    });

    document.addEventListener("click", function (e) {
        const link = e.target.closest(".page-link-custom");
        if (!link) return;

        e.preventDefault();

        const page = parseInt(link.dataset.page);
        if (!isNaN(page)) {
            changePage(page);
        }
    });
</script>
