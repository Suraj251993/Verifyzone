@{
    Layout = "~/Views/Shared/_VZoneLayout.cshtml";
}
<link rel="stylesheet" href="/assets/css/search-candidate.css">
<link rel="stylesheet" href="/assets/css/verification-request.css">
<link rel="stylesheet" href="/assets/css/bulk.css">
<link rel="stylesheet" href="/assets/css/exit-details.css">
<link rel="stylesheet" href="/assets/css/new-request.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/js/common.js" asp-append-version="true"></script>
<link rel="stylesheet" href="/assets/css/generate-report.css">
<link rel="stylesheet" href="/assets/css/access-denied.css">

<div class="breadcrumbs" style="padding: 10px 0px 20px 5px"><a href="/Customer/VIndex"><i
            class="ri-home-8-line" style="color: var(--purple-color)"></i></a> <i class="ri-arrow-right-s-line"
        style="color: var(--purple-color)"></i> <span
        style="color: var(--purple-color);font-size: 14px;">V-Zone</span> <i class="ri-arrow-right-s-line"
        style="color: var(--purple-color)"></i> <span
        style="color: var(--purple-color);font-size: 14px;">Employment verification</span> <i
        class="ri-arrow-right-s-line" style="color: var(--purple-color)"></i><span style="font-size: 14px;">Search
        history</span>
</div>
@if (ViewBag.AccessLevel == 2 || ViewBag.AccessLevel == 3)
{
    <div class="content">
    <h5 class="bulk-table-heading mb-4">Employment - Search history</h5>
    <div class="row justify-content-center">
        <div class="col-md-3">
            <div class="dateInputContainer">
                <input required autocomplete="off" id="fromDate" class="fromDate" type="text"
                       placeholder="From date" />
                <div class="label-container">
                    <i class="ri-calendar-line label-icon"></i>
                    <label class="dateLabel" for="fromDate">From date</label>
                </div>
                <i class="ri-calendar-line dateIcon"></i>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dateInputContainer">
                <input required autocomplete="off" id="toDate" class="toDate" type="text"
                       placeholder="To date" />
                <div class="label-container">
                    <i class="ri-calendar-2-line label-icon"></i>
                    <label class="dateLabel" for="toDate">To date</label>
                </div>
                <i class="ri-calendar-2-line dateIcon"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="inputContainer reasonContainer" id="inputContainer" style="position: relative;">
                <input required="required" autocomplete="off" class="input-container" placeholder="-- Search result --"
                       type="text" readonly>
                <label class="usernameLabel">Search result</label>
                <i class="ri-search-line userIcon"></i>
                <svg viewBox="0 0 320 512" class="chevronIcon" id="chevronIcon">
                    <path d="M143 352.3L7 216.3c-9.4-9.4-9.4-24.6 0-33.9l22.6-22.6c9.4-9.4
                                                        24.6-9.4 33.9 0L160 239.4l96.5-96.5c9.4-9.4
                                                        24.6-9.4 33.9 0l22.6 22.6c9.4 9.4
                                                        9.4 24.6 0 33.9l-136 136c-9.4 9.4-24.6
                                                        9.4-33.9 0z" />
                </svg>
                <div id="dropdownMenu" class="newinput-dropdown-menu"></div>
            </div>
        </div>
    </div>
    <div class="w-100 d-flex justify-content-center mt-2">
        @Html.Hidden("hdncategory", (object)ViewBag.IsBGV)
        <button class="btn-submit" id="btnresult">
            <div class="original">Search</div>
            <div class="letters">
                <span>S</span>
                <span>e</span>
                <span>a</span>
                <span>r</span>
                <span>c</span>
                <span>h</span>
            </div>
        </button>
    </div>
    <div class="card p-0 mt-5 mb-4 border-0">
        <table>
            <thead style="background: #f8ece2">
                <tr>
                    <th class="sortable">
                        ID<i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Employee code <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Name <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Customer name <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Search result <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Search date <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Approved date <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Final result <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th>
                        Action
                    </th>
                </tr>
            </thead>
            <tbody class="tbody-tr tbodyTr" id="tableIdx">
            </tbody>
        </table>
        <div class="text-center" id="divnorecord">
            <img src="/assets/img/no-data-found-img.jpg" alt="no-record-found" style="height: 200px;">
            <h6 class="no-data-found-text">No record found</h6>
        </div>

    </div>
    <div class="modal fade" id="clientname" data-bs-backdrop="static" data-bs-keyboard="false"
            tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h1 class="modal-title bulk-table-heading fs-5" id="staticBackdropLabel">
                        Client name
                    </h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="inputContainer" style=" position: relative;">
                                <input required autocomplete="off" class="input-container" class="login-pass"
                                        placeholder="Enter the client name for which you are doing the verification" type="text" id="txtclientname">
                                <label class="usernameLabel">Client name</label>
                                <i class="ri-lock-password-line userIcon"></i>
                            </div>
                            <input type="hidden" id="hdnsearch" name="hdnsearch" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button class="btn-closes border-0" data-bs-dismiss="modal"
                            style="background-color: gray;">
                        <div class="original" style="background-color: gray;">Close</div>
                        <div class="letters" style="background-color: gray;">
                            <span>C</span>
                            <span>l</span>
                            <span>o</span>
                            <span>s</span>
                            <span>e</span>
                        </div>
                    </button>&nbsp;&nbsp;
                    <button class="btn-submit" type="button" name="save" value="Save" id="btnGenerateReport">
                        <div class="original">Generate report</div>
                        <div class="letters">
                            <span>G</span>
                            <span>e</span>
                            <span>n</span>
                            <span>e</span>
                            <span>r</span>
                            <span>a</span>
                            <span>t</span>
                            <span>e</span>
                            <span class="ms-1"></span>
                            <span>R</span>
                            <span>e</span>
                            <span>p</span>
                            <span>o</span>
                            <span>r</span>
                            <span>t</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
}
else
{
    <div class="container">
        <div class="container-access">
            <img src="/assets/img/403 Access Denied.png" alt="">
            <h5 class="access-header-first-403">Oops !!!</h5>
            <h6 class="access-header-403">Access denied</h6>
            <p class="access-para-403">You are not authorized to view this page. <br> Please return to the homepage or contact support.</p>
            <a href="/Home/Landing">
                <button class="access-back-btn">Go back</button>
            </a>
        </div>
    </div>
}

<script src="~/assets/js/html2canvas.min.js"></script>
<script src="~/assets/js/jspdf.umd.min.js"></script>
<script src="/assets/js/sort.js" asp-append-version="true"></script>
<script src="~/assets/js/canvasjs.min.js"></script>
<script src="/assets/js/exit-details.js?ver=2" asp-append-version="true"></script>
<script src="/assets/js/pages/pastsearches.js?ver=2" asp-append-version="true"></script>
<script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
    const dropmenus = document.querySelectorAll(".newinput-dropdown-menu");
    dropmenus.forEach(dropmenu => {
        dropmenu.addEventListener("click", () => {
            dropmenu.classList.toggle("show");
        });
    });
    var searchurl = '@Url.Action("GetSearchHistory", "Customer")';
    var balanceurl = '@Url.Action("GetCustomerBalance", "Customer")';
    var reporturl = '@Url.Action("GenerateReportDataBySearchId", "Customer")';
    var reminderurl = '@Url.Action("SendRecertificationReminder", "Customer")';
    ShowBalance(balanceurl);
    document.getElementById("btnresult").addEventListener("click", function() { refreshGrid(searchurl); }, false);
    document.getElementById("btnGenerateReport").addEventListener("click", function() { btnGenerateReport(balanceurl, reporturl, searchurl); }, false);
    document.addEventListener("click", function (e) {
        const btn = e.target.closest(".action-btn");
        if (!btn) return;

        const id = btn.dataset.id;
        const action = btn.dataset.action;

        switch (action) {
            case "capture":
                CaptureClient(id);
                break;
            case "generate":
                GenerateReport(id, reporturl, searchurl);
                break;
            case "reminder":
                SendReminder(id, reminderurl);
                break;
        }
    });
</script>
<script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
    document.addEventListener("DOMContentLoaded", function () {
        const fromPicker = flatpickr(".fromDate", {
            dateFormat: "d-m-Y",
            onChange: function (selectedDates) {
                if (selectedDates.length === 0) return;

                let nextDay = new Date(selectedDates[0]);
                nextDay.setDate(nextDay.getDate());

                toPicker.set("minDate", nextDay);

                if (toPicker.selectedDates.length > 0 && toPicker.selectedDates[0] < nextDay) {
                    toPicker.clear();
                }
            }
        });

        const toPicker = flatpickr(".toDate", {
            dateFormat: "d-m-Y"
        });

    });
    
    document.addEventListener("click", function (e) {
        const link = e.target.closest(".page-link-custom");
        if (!link) return;

        e.preventDefault();

        const page = parseInt(link.dataset.page);
        if (!isNaN(page)) {
            changePage(page);
        }
    });
</script>
