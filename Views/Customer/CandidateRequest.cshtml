<div class="breadcrumbs" style="padding: 10px 0px 20px 5px">
    <a href="dashboardxzone.html">
        <i class="ri-home-8-line" style="color: var(--purple-color)"></i>
    </a> <i class="ri-arrow-right-s-line"
            style="color: var(--purple-color)"></i> 
            <span style="color: var(--purple-color);font-size: 14px;">V-Zone</span> 
            <i class="ri-arrow-right-s-line" style="color: var(--purple-color)"></i> 
            <span style="color: var(--purple-color);font-size: 14px;">Employment verification</span> 
            <i class="ri-arrow-right-s-line" style="color: var(--purple-color)"></i><span style="font-size: 14px;">
        Candidate
        request
    </span>
</div>


<div class="content">
    <div class="exz-page-head">
        <h1>Candidate request status</h1>
        <p>Search verification requests raised for candidates and review the HR replies received.</p>
    </div>

    <div class="exz-filter-card">
        <div class="row justify-content-center align-items-end">
            <div class="col-md-5">
                <label class="usernameLabel d-block mb-1" for="mddsearchfilter">Search by status</label>
                <select class="form-select input-container" id="mddsearchfilter" aria-label="Search by status">
                    @* <option value="">-- Choose option--</option> *@
                    <option value="openOnly">Open request only</option>
                    <option value="replyOnly">Reply received only</option>
                </select>
            </div>
            <div class="col-md-3 mt-3 mt-md-0 d-flex justify-content-center">
                <button type="button" class="btn-submit" id="Search">
                    <div class="original">Search</div>
                    <div class="letters">
                        <span>S</span>
                        <span>e</span>
                        <span>a</span>
                        <span>r</span>
                        <span>c</span>
                        <span>h</span>
                    </div>
                </button>
            </div>
        </div>
    </div>

    <p class="exz-section-title mt-4">Search results</p>
    <div class="card exz-table-card p-0 mt-2 mb-4 border-0">
        <div class="table-responsive">
            <table id="tablelist" class="datatables-ajax table table-bordered">
                <thead>
                    <tr>
                        <th>Employee code</th>
                        <th>Customer name</th>
                        <th>Request comments</th>
                        <th>Raised by</th>
                        <th>Raised date</th>
                        <th>HR comments</th>
                        <th>Replied by</th>
                        <th>Replied date</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        var balanceurl = '@Url.Action("GetCustomerBalance", "Customer")';
        ShowBalance(balanceurl);
        refreshGrid($('#mddsearchfilter').val());
        $('#loading').hide();
    });
    function refreshGrid(filter) {
        $('#loading').show();
        //alert(filter);
        const filtervalue = filter;
        $.ajax({
            // url: '@Url.Action("GetEmployeeRequestsByCustomer", "Customer")',
                url: 'GetEmployeeRequestsByCustomer?filtervalue=' + filtervalue,

            type: 'GET',
            dataType: 'json', // changing data type to json
            error: function (xhr) {
                alert('Error: ' + xhr.statusText);
                $('#loading').hide();
            },
            success: function (result) {
                //console.log('ds', result);
                setToTable(result);
                $('#loading').hide();
            },
            async: true,
            processData: false
        });
    }
    function setToTable(jsonData) {
        //console.log(jsonData);
        var arraydata = [];
        for (let i = 0; i < jsonData.length; i++) {
            var data = [];
            data.push(jsonData[i].empcode);
            data.push(jsonData[i].customername);
            data.push(jsonData[i].requestcomments);
            data.push(jsonData[i].raisedbyname);
            data.push(jsonData[i].raiseddate);
            data.push(jsonData[i].hrcomments);
            data.push(jsonData[i].repliername);
            data.push(getDisplayDate(jsonData[i].replieddate));
            arraydata.push(data);            
        }
        var ajaxdata = {
            "draw": 1,
            "recordsTotal": jsonData.length,
            "recordsFiltered": jsonData.length,
            "data": arraydata
        };

        var dt_ajax = $('#tablelist').dataTable({
            destroy: true,
            processing: true,
            data: ajaxdata.data,
            dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6 d-flex justify-content-center justify-content-md-end"f>><"table-responsive"t><"row"<"col-sm-12 col-md-6"i><"col-sm-12 col-md-6"p>>',
            language: {
                paginate: {
                    next: '<i class="ri-arrow-right-s-line"></i>',
                    previous: '<i class="ri-arrow-left-s-line"></i>'
                }
            }
        });

    }
    function getDisplayDate(data) {
        var date = new Date(data);
        var month = date.getMonth() + 1;
        return date.getDate() + "/" + (month.toString().length > 1 ? month : "0" + month) + "/" + date.getFullYear();
    }
    $('#Search').click(function () {
        refreshGrid($('#mddsearchfilter').val());
    });
</script>
