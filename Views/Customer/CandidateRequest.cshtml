<div class="row gy-4">
    <div class="col-xl-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Candidate request status</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="form-floating form-floating-outline col-md">
                        <select class="form-select" id="mddsearchfilter" aria-label="Default select example">
                            @* <option value="">-- Choose option--</option> *@
                            <option value="openOnly">Open request only</option>
                            <option value="replyOnly">Reply received only</option>
                        </select>
                        <label for="mddsearchfilter">Search by status</label>
                    </div>
                    <div class="form-floating form-floating-outline mb-3 col-md">
                        <button type="button" class="btn btn-primary" id="Search">Search</button>
                    </div>
                    <div class="form-floating form-floating-outline mb-3 col-md">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row gy-4">
    <div class="col-xl-12">
        <div class="card mb-12">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Search results</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="mb-12 col-md">
                        <table id="tablelist" class="datatables-ajax table table-bordered">
                            <thead>
                                <tr>
                                    <th>Employee code</th>
                                    <th>Customer name</th>
                                    <th>Request comments</th>
                                    <th>Raised by</th>
                                    <th>Raised date</th>
                                    <th>HR comments</th>
                                    <th>Replied by</th>
                                    <th>Replied date</th>
                                </tr>
                            </thead>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        var balanceurl = '@Url.Action("GetCustomerBalance", "Customer")';
        ShowBalance(balanceurl);
        refreshGrid($('#mddsearchfilter').val());
        $('#loading').hide();
    });
    function refreshGrid(filter) {
        $('#loading').show();
        //alert(filter);
        const filtervalue = filter;
        $.ajax({
            // url: '@Url.Action("GetEmployeeRequestsByCustomer", "Customer")',
                url: 'GetEmployeeRequestsByCustomer?filtervalue=' + filtervalue,

            type: 'GET',
            dataType: 'json', // changing data type to json
            error: function (xhr) {
                alert('Error: ' + xhr.statusText);
                $('#loading').hide();
            },
            success: function (result) {
                //console.log('ds', result);
                setToTable(result);
                $('#loading').hide();
            },
            async: true,
            processData: false
        });
    }
    function setToTable(jsonData) {
        //console.log(jsonData);
        var arraydata = [];
        for (let i = 0; i < jsonData.length; i++) {
            var data = [];
            data.push(jsonData[i].empcode);
            data.push(jsonData[i].customername);
            data.push(jsonData[i].requestcomments);
            data.push(jsonData[i].raisedbyname);
            data.push(jsonData[i].raiseddate);
            data.push(jsonData[i].hrcomments);
            data.push(jsonData[i].repliername);
            data.push(getDisplayDate(jsonData[i].replieddate));
            arraydata.push(data);            
        }
        var ajaxdata = {
            "draw": 1,
            "recordsTotal": jsonData.length,
            "recordsFiltered": jsonData.length,
            "data": arraydata
        };

        var dt_ajax = $('#tablelist').dataTable({
            destroy: true,
            processing: true,
            data: ajaxdata.data,
            dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6 d-flex justify-content-center justify-content-md-end"f>><"table-responsive"t><"row"<"col-sm-12 col-md-6"i><"col-sm-12 col-md-6"p>>',
            language: {
                paginate: {
                    next: '<i class="ri-arrow-right-s-line"></i>',
                    previous: '<i class="ri-arrow-left-s-line"></i>'
                }
            }
        });

    }
    function getDisplayDate(data) {
        var date = new Date(data);
        var month = date.getMonth() + 1;
        return date.getDate() + "/" + (month.toString().length > 1 ? month : "0" + month) + "/" + date.getFullYear();
    }
    $('#Search').click(function () {
        refreshGrid($('#mddsearchfilter').val());
    });
</script>
