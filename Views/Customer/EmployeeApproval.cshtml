<script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
    $(function() {
        const fromPicker = flatpickr("#Fromdate", {
        dateFormat: "d-m-Y",
        onChange: function (selectedDates) {
            if (selectedDates.length === 0) return;

            let nextDay = new Date(selectedDates[0]);
            nextDay.setDate(nextDay.getDate() + 1);

            toPicker.set("minDate", nextDay);

            if (toPicker.selectedDates.length > 0 && toPicker.selectedDates[0] < nextDay) {
                toPicker.clear();
            }
        }
        });

        const toPicker = flatpickr("#Todate", {
            dateFormat: "d-m-Y"
            });

    });

    const API = {
        edit: '@Url.Action("SaveEmployeeQuestions", "Customer")',
        approve: '@Url.Action("EmployeeApproval", "Customer")',
        get: '@Url.Action("GetEmployee", "Customer")'
    };
    
    document.getElementById("btnedit").addEventListener("click", function() { editemployee(API.edit); }, false);
    document.getElementById("btnapprove").addEventListener("click", function() { approve(API.approve); }, false);
    document.addEventListener('DOMContentLoaded', function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });

    document.addEventListener("click", function (e) {
        if (e.target.closest(".new-request-table-delete-btn")) {
            const row = e.target.closest("#loadid");
            loademployee(row.dataset.id, row.dataset.val, API.get);
        }
    });
</script>
