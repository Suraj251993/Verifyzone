@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "";
}
@model OrgCheck.ViewModels.AbscondDetailViewModel
<style>:root{--purple-color:#5c249a;--light-purple-color:#340c62;}</style>
<link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
<link href="/assets/remix/fonts/remixicon.css" rel="stylesheet">
<link rel="stylesheet" href="~/assets/css/dash.css" asp-append-version="true">
<link rel="stylesheet" href="~/assets/css/exit-details.css" asp-append-version="true">
@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/toastr/toastr.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/animate-css/animate.dist.css">
}
@section VendorScripts {
    <script src="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.dist.js"></script>
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
    <script src="~/vendor/libs/toastr/toastr.dist.js"></script>
    <script src="~/js/common.js?ver=1"></script>
}
<div class="content">
    <h5 class="bulk-table-heading mb-4">Add additional details</h5>
    <form>
        <div class="row">
            <div class="col-md-6">
                <div class="inputContainer">
                    @Html.TextBoxFor(model => model.Name, new { @class = "input-container", @type = "text", @placeholder = "Employee name", @autocomplete = "off", autofocus = "autofocus" })
                    <label class="usernameLabel">Employee name</label>
                    <i class="ri-user-6-line userIcon"></i>
                </div>
            </div>
            <div class="col-md-6">
                <div class="inputContainer">
                    @Html.TextBoxFor(model => model.Employeecode, new { @class = "input-container", @type = "text", @placeholder = "Employee code", @autocomplete = "off" })
                    <label class="usernameLabel">Employee code</label>
                    <i class="ri-user-settings-line userIcon"></i>
                </div>
            </div>
            <div class="col-md-6">
                <div class="dateInputContainer">
                    @Html.TextBoxFor(model => model.Joindate, new { @class = "input-container", @type = "text", @placeholder = "DD/MM/YYYY", @autocomplete = "off" })
                    <div class="label-container">
                        <i class="ri-calendar-line label-icon"></i>
                        <label class="dateLabel" for="Joindate">Join date</label>
                    </div>
                    <i class="ri-calendar-line dateIcon"></i>
                </div>
            </div>
            <div class="col-md-6">
                <div class="dateInputContainer">
                    @Html.TextBoxFor(model => model.Lastworkingdate, new { @class = "input-container", @type = "text", @placeholder = "DD/MM/YYYY", @autocomplete = "off" })
                    <div class="label-container">
                        <i class="ri-calendar-2-line label-icon"></i>
                        <label class="dateLabel" for="Lastworkingdate">Last working date</label>
                    </div>
                    <i class="ri-calendar-2-line dateIcon"></i>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="inputContainer">
                    @Html.TextBoxFor(model => model.Mobileno, new { @class = "input-container", @type = "text", @placeholder = "Mobile no.", @autocomplete = "off" })
                    <label class="usernameLabel">Mobile no.</label>
                    <i class="ri-phone-line userIcon"></i>
                </div>
            </div>
            <div class="col-md-6">
                <div class="inputContainer">
                    @Html.TextBoxFor(model => model.Uannumber, new { @class = "input-container", @type = "text", @placeholder = "UAN number", @autocomplete = "off" })
                    <label class="usernameLabel">UAN number</label>
                    <i class="ri-numbers-line userIcon"></i>
                </div>
            </div>
            <div class="col-md-6">
                <div class="inputContainer">
                    @Html.TextBoxFor(model => model.Fathername, new { @class = "input-container", @type = "text", @placeholder = "Father name", @autocomplete = "off" })
                    <label class="usernameLabel">Father name</label>
                    <i class="ri-group-2-line userIcon"></i>
                </div>
            </div>
            <div class="col-md-6">
                <div class="inputContainer">
                    @Html.TextBoxFor(model => model.Emailid, new { @class = "input-container", @type = "text", @placeholder = "Email id", @autocomplete = "off" })
                    <label class="usernameLabel">Email id</label>
                    <i class="ri-mail-unread-line userIcon"></i>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="inputContainer">
                    @Html.DropDownList("discrepancytype", (IEnumerable<SelectListItem>)ViewBag.DiscrepancyTypes, "Please highlight", new { @class = "form-select input-container", @id = "mdddiscrepancytype" })
                    <label class="usernameLabel">Please highlight</label>
                    <i class="ri-checkbox-circle-line userIcon"></i>
                </div>
            </div>
            <div class="col-md-6">
                <div class="inputContainer">
                    @Html.TextBoxFor(model => model.Remarks, new { @class = "input-container", @type = "text", @placeholder = "Remarks", @autocomplete = "off" })
                    <label class="usernameLabel">Remarks</label>
                    <i class="ri-file-text-line userIcon"></i>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="inputContainer">
                    @Html.TextBoxFor(model => model.Linkedinurl, new { @class = "input-container", @type = "text", @placeholder = "Linked-in URL", @autocomplete = "off" })
                    <label class="usernameLabel">Linked-in URL</label>
                    <i class="ri-linkedin-box-line userIcon"></i>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <h6 class="upload-resume-header-exitdetails">
                    <i class="ri-upload-cloud-line"></i> <strong>Upload resume</strong>
                </h6>
                <label class="exit-resume-upload-field d-flex flex-column justify-content-center align-items-center">
                    <input name="resume" type="file" hidden />
                    <p class="file-prompt mb-1 pt-4"><i class="ri-upload-cloud-2-line fs-2"></i></p>
                    <p class="text-muted mb-1">Drag &amp; Drop your file here</p>
                    <p class="text-muted mb-1">or Click to Browse</p>
                </label>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-3">
                <button type="button" class="btn-submit" id="SaveDetail">
                    <div class="original">Submit</div>
                    <div class="letters">
                        <span>S</span><span>u</span><span>b</span><span>m</span><span>i</span><span>t</span>
                    </div>
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {
        var balanceurl = '@Url.Action("GetCustomerBalance", "Customer")';
        ShowBalance(balanceurl);
        var bsjoindate = $('#Joindate'),
            bslastworkingdate = $('#Lastworkingdate');
        bsjoindate.datepicker({
            todayHighlight: true,
            autoclose: true,
            format: 'dd/mm/yyyy',
            orientation: isRtl ? 'auto right' : 'auto left'
        });
        bslastworkingdate.datepicker({
            todayHighlight: true,
            autoclose: true,
            format: 'dd/mm/yyyy',
            orientation: isRtl ? 'auto right' : 'auto left'
        });
        $('#loading').hide();
        $('#SaveDetail').click(function () {
            var requestData = {
                name: $.trim($('#Name').val()),
                employeecode: $.trim($('#Employeecode').val()),
                joindate: $.trim($('#Joindate').val()),
                lastworkingdate: $.trim($('#Lastworkingdate').val()),
                mobileno: $.trim($('#Mobileno').val()),
                uannumber: $.trim($('#Uannumber').val()),
                fathername: $.trim($('#Fathername').val()),
                emailid: $.trim($('#Emailid').val()),
                discrepancytype: parseInt($('#mdddiscrepancytype option:selected').val()),
                remarks: $.trim($('#Remarks').val()),
                linkedinurl: $.trim($('#Linkedinurl').val())
            };
            $.ajax({
                url: '@Url.Action("AddAbscondDetail", "Customer")',
                type: 'POST',
                data: JSON.stringify(requestData),
                dataType: 'json',
                contentType: 'application/json;',
                error: function (xhr) {
                    alert('Error: ' + xhr.statusText);
                },
                success: function (result) {
                    if (result == true) {
                        $('#loading').hide();
                        clearFields();
                        // Show success toast message
                        showSuccessMessage('Data saved');
                    }
                    else {
                        $('#loading').hide();
                        showErrorMessage('Error occured while saving the data');
                    }
                },
                async: true,
                processData: false
            });
        });
    });
    function clearFields() {
        $('#Name').val('');
        $('#Employeecode').val('');
        $('#Joindate').val('');
        $('#Lastworkingdate').val('');
        $('#Mobileno').val('');
        $('#Uannumber').val('');
        $('#Fathername').val('');
        $('#Emailid').val('');
        $('#Linkedinurl').val('');
        $('#Remarks').val('');
        $('#mdddiscrepancytype').prop('selectedIndex', 0);
    }
</script>
