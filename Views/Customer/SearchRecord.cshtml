<script src="~/assets/js/pages/searchrecord.js?ver=1" asp-append-version="true"></script>
<script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
    $(document).ready(function () {
        var searchurl = '@Url.Action("GetResults", "Customer")';
        var balanceurl = '@Url.Action("GetCustomerBalance", "Customer")';
        ShowBalance(balanceurl);
        //$('#loading').hide();
        const searchBtn = document.getElementById("GetDetail");
        searchBtn.addEventListener("click", () => {
            BindDetail(searchurl);
        });
    });
    document.addEventListener("click", function (e) {
        const link = e.target.closest(".page-link-custom");
        if (!link) return;

        e.preventDefault();

        const page = parseInt(link.dataset.page);
        if (!isNaN(page)) {
            changePage(page);
        }
    });
</script>