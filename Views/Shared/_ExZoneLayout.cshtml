                                </h5>
                                <h6 class="logout-popup-dahx"> Are you sure <br> you want to switch to V-zone?</h6>
                            </div>
                            <div class="modal-footer border-0 justify-content-center">
                                <button class="btn-closes" data-bs-dismiss="modal">
                                    <div class="original">No</div>
                                    <div class="letters">
                                        <span>N</span>
                                        <span>o</span>
                                    </div>
                                </button>&nbsp;&nbsp;                               
                                <button class="btn-submit" id="btnvzone" type="button" name="next">
                                    <div class="original">Yes</div>
                                    <div class="letters">
                                        <span>Y</span>
                                        <span>e</span>
                                        <span>s</span>
                                    </div>
                                </button>                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="navbar-right">
                @* <img src="~/assets/img/Zoho_Corporation-Logo.wine.png" alt="" class="navbar-client-logo"> *@
                <div class="navbar-help-section">
                    <div class="dropdown">
                        <button class=" profile-wrapper active help-text">
                            <i class="ri-question-line"></i> Help
                            <i class="ri-arrow-down-s-line"></i>
                        </button>
                        <div class="dropdown-menu border-0" style="margin-top: -20px; width: 100px;">
                            @* <a class="drop-profile-items" href="help-center.html">
                                <i class="ri-question-line"></i> Help
                            </a> *@
                            <a class="drop-profile-items active" href="/Customer/ExzoneRoadmap">
                                <i class="ri-pin-distance-line"></i> Road map
                            </a>
                        </div>
                    </div>
                </div>
                <div class="profile">
                    <div class="dropdown">
                        <button class="dropdown-btn profile-wrapper">
                            <img src="/assets/img/profile-nav.jpg" alt="Profile" class="profile-img">
                            <span class="active-indicator"></span>
                        </button>
                        <div class="dropdown-menu border-0" style="margin-top: -3px;">
                            <div class="border-bottom d-flex gap-1 px-2">
                                <div class="profile-wrapper1">
                                    <img src="~/assets/img/profile-nav.jpg" alt="Profile" class="profile-img-sub">
                                    <span class="active-indicator1"></span>
                                </div>
                                <p class="pt-1">@User.Identity.Name</p>
                            </div>
                            <a class="drop-profile-items" data-bs-toggle="modal" data-bs-target="#profilePopup" id="lnkprofile">
                                <i class="ri-user-line"></i> My Profile
                            </a>
                            <a class="drop-profile-items" data-bs-toggle="modal" data-bs-target="#changepassword">
                                <i class="ri-settings-3-line"></i> Change password
                            </a>
                            <a class="drop-profile-items" id="lnkbalance">
                                <i class="ri-file-text-line"></i> Report balance <span id="lblbalance" class="profile-drop-noti"></span>
                            </a>
                            <a class="drop-profile-items" style="color: red;" data-bs-toggle="modal"
                               data-bs-target="#staticBackdrop">
                                <i class="ri-logout-box-r-line"></i> Logout
                            </a>
                        </div>
                    </div>
                    <!-- log-out -->
                    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false"
                         tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header border-0">
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                </div>
                                <div class="modal-body text-center">
                                    <h5 class="logout-popup-dahx-icon"><i class="ri-logout-circle-line"></i></h5>
                                    <h6 class="logout-popup-dahx">
                                        Are you sure <br>
                                        You want to log-out ?
                                    </h6>
                                </div>
                                <div class="modal-footer border-0 justify-content-center">
                                    <button class="btn-closes" data-bs-dismiss="modal">
                                        <div class="original">No</div>
                                        <div class="letters">
                                            <span>N</span>
                                            <span>o</span>
                                        </div>
                                    </button>&nbsp;&nbsp;                                    
                                    <button class="btn-submit" id="logout-btn" type="button" name="logout-btn">
                                        <div class="original">Yes</div>
                                        <div class="letters">
                                            <span>Y</span>
                                            <span>e</span>
                                            <span>s</span>
                                        </div>
                                    </button>                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- profile -->
                    <div class="modal fade" id="profilePopup" data-bs-backdrop="static" data-bs-keyboard="false"
                         tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content">
                                <div class="modal-header border-0">
                                    <h1 class="modal-title bulk-table-heading fs-5" id="staticBackdropLabel">
