    <script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
        document.querySelectorAll('.sidebar-items').forEach(item => {
            item.addEventListener('click', () => {
                item.parentElement.classList.toggle('open');
            });
        });
    </script>
    
    <script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>

    <script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
        const togglePassword = document.getElementById('togglePassword');
        const togglePassword1 = document.getElementById('togglePassword1');
        const togglePassword2 = document.getElementById('togglePassword2');
        const passwordField = document.querySelector('.login-pass');
        const passwordField1 = document.querySelector('.login-pass1');
        const passwordField2 = document.querySelector('.login-pass2');

        togglePassword.addEventListener('click', () => {
            const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField.setAttribute('type', type);

            togglePassword.classList.toggle('ri-eye-line');
            togglePassword.classList.toggle('ri-eye-off-line');
        });
        togglePassword1.addEventListener('click', () => {
            const type = passwordField1.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField1.setAttribute('type', type);

            togglePassword1.classList.toggle('ri-eye-line');
            togglePassword1.classList.toggle('ri-eye-off-line');
        });
        togglePassword2.addEventListener('click', () => {
            const type = passwordField2.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField2.setAttribute('type', type);

            togglePassword2.classList.toggle('ri-eye-line');
            togglePassword2.classList.toggle('ri-eye-off-line');
        });
    </script>

    <script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
        var transactiontableData = [];
        $(function () {
            var data = '@ViewBag.Category';
            if (data == "2") {
                $('#lnkview').show();
            }
            else {
                $('#lnkview').hide();
            }
            ShowBalance();
            document.getElementById("ChPassSave").addEventListener("click", savePassword);
            document.getElementById("lnkprofile").addEventListener("click", getProfile);
            document.getElementById("SaveProfile").addEventListener("click", saveProfile);
            document.getElementById("btnvzone").addEventListener("click", gotoVzone);
            document.getElementById("lnkbalance").addEventListener("click", bindTransactionSummary);
            document.getElementById("logout-btn").addEventListener("click", logout);
            document.getElementById("error").addEventListener("click", function() {
                closeModal(this);
            });

            function gotoVzone() {
                window.location = '@Url.Action("VIndex", "Customer")'; //"/Customer/VIndex";
            }
            function savePassword() {
                //if (!$('#frmchpass').valid()) return;
                var requestData = {
                    oldpassword: $.trim($('#OldPassword').val()),
                    newpassword: $.trim($('#NewPassword').val()),
                    confirmpassword: $.trim($('#ConfirmPassword').val()),
                }
                if ($('#OldPassword').val() == "" || $('#NewPassword').val() == "" || $('#ConfirmPassword').val() == "") {
                    showErrorMessage("All 3 fields are mandatory");
                    return;
                }
                // Show loader overlay
                const overlay = document.getElementById("formLoaderOverlay");
                overlay.style.display = "flex";
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("ChangePassword", "Customer")',
                    data: JSON.stringify(requestData),
                    dataType: 'json', // changing data type to json
                    contentType: 'application/json; charset=utf-8',                    
                    success: function (data) { // here I'm adding data as a parameter which stores the response
                        //console.log(data); // instead of alert I'm changing this to console.log which logs all the response in console.
                        if (data == true) {
                            $('#changepassword').modal('hide');
                            overlay.style.display = "none";
                            showSuccessMessage('Password updated. Kindly logout and re-login');
                        }
                        else if (data == false) {
                            $('#changepassword').modal('hide');
                            overlay.style.display = "none";
                            showErrorMessage('Invalid password');
                        }
                        else {
                            $('#changepassword').modal('hide');
                            overlay.style.display = "none";
                            showErrorMessage('Error occured while updating the password');
                        }
                        clearFields();
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            }
            function getProfile() {
                // Show loader overlay
                const overlay = document.getElementById("formLoaderOverlay");
                overlay.style.display = "flex";
                $.ajax({
                        type: 'GET',
                        dataType: 'JSON',
                        url: '@Url.Action("Profile", "Customer")',
                        success:
                            function (jsonData) {
                                //console.log(jsonData);
                                $('#mid').val(jsonData.id);
                                $('#profiledisplayname').val(jsonData.displayname);
                                formatField('profiledisplayname');
                                $('#profileemail').val(jsonData.email);
                                formatField('profileemail');
                                $('#profiledesignation').val(jsonData.designation);
                                formatField('profiledesignation');
                                $('#profilecontactnumber').val(jsonData.contactnumber);
                                formatField('profilecontactnumber');
                                $('#profileteam').val(jsonData.team);
                                formatField('profileteam');
                                $('#profilefunction').val(jsonData.function);
                                formatField('profilefunction');
                                $('#profilemanagername').val(jsonData.rptmgrname);
                                formatField('profilemanagername');
                                $('#profilemanagerdesignation').val(jsonData.rptmgrdesignation);
                                formatField('profilemanagerdesignation');
                                overlay.style.display = "none";
                            },
                        error:
                            function (response) {
                                console.log(response);
                                overlay.style.display = "none";
                                showErrorMessage("Error: " + response.statusText);
                            }
                    }
                );
            }
            function saveProfile() {
                if ($('#profiledisplayname').val() == "" || $('#profiledesignation').val() == "" || $('#profilecontactnumber').val() == "" || $('#profileemail').val() == "") {
                    showErrorMessage("* fields are mandatory");
                    return;
                }

                //if (!$('#frmEmpForm').valid()) return;
                //e.preventDefault();
                // Show loader overlay
                const overlay = document.getElementById("formLoaderOverlay");
                overlay.style.display = "flex";

                var postdata = {
                    id: $('#mid').val(),
                    displayname: $("#profiledisplayname").val(),
                    contactnumber: $("#profilecontactnumber").val(),
                    designation: $("#profiledesignation").val(),
                    email: $("#profileemail").val(),
                    team: $("#profileteam").val(),
                    function: $("#profilefunction").val(),
                    rptmgrname: $("#profilemanagername").val(),
                    rptmgrdesignation: $("#profilemanagerdesignation").val(),
                }

                var url = '@Url.Action("UpdateProfile", "Customer")';
                $.ajax({
                    type: 'POST',
                    url: url,
                    data: JSON.stringify(postdata),
                    contentType: "application/json",
                    dataType: 'json', // changing data type to json
                    success: function (data) { // here I'm adding data as a parameter which stores the response
                        //console.log(data); // instead of alert I'm changing this to console.log which logs all the response in console.
                        if (data == true) {
                            overlay.style.display = "none";
                            $('#profilePopup').modal('hide');
                            showSuccessMessage('Profile saved');
                        }
                        else {
                            overlay.style.display = "none";
                            $('#profilePopup').modal('hide');
                            showErrorMessage(data);
                        }
                    },
                    error: function (err) {
                        console.log(err);
                        overlay.style.display = "none";
                        $('#profilePopup').modal('hide');
                        showErrorMessage("Error: " + err.statusText);
                    }
                });
            }
            
            function clearFields() {
                $('#OldPassword').val('');
                $('#NewPassword').val('');
                $('#ConfirmPassword').val('');
            }
            function logout() {
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("Logout", "Home")',
                    dataType: 'json', // changing data type to json
                    success: function (data) { // here I'm adding data as a parameter which stores the response
                        //console.log(data); // instead of alert I'm changing this to console.log which logs all the response in console.
                        if (data == true) {
                            window.location = "/";
                            
                        }
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            }            
            function validateField(id) {
                if ($('#' + id).val() == '') {
                    $('#' + id).removeClass('filled');
                }
                else {
                    $('#' + id).addClass('filled');
                }            
            }
            
        });
        function formatField(id) {
            if ($('#' + id).val() == '') {
                $('#' + id).removeClass('filled');
            }
            else {
                $('#' + id).addClass('filled');
            }
        }
        function bindTransactionSummary() {
            // Show loader overlay
            const overlay = document.getElementById("formLoaderOverlay");
            overlay.style.display = "flex";
            $.ajax({
                    type: 'GET',
                    dataType: 'JSON',
                    url: '@Url.Action("GetWalletTransactions", "Customer")',
                    success:
                        function (jsonData) {
                            //console.log(jsonData);
                            $('#transactionsummary').modal('show');
                            transactiontableData = [];
                            // Generate HTML table.
                            for (let i = 0; i < jsonData.length; i++) {
                                let value = '';
                                if (jsonData[i].text.includes("report generated"))
                                    value = '-' + jsonData[i].value;
                                else
                                    value = jsonData[i].value;
                                transactiontableData.push({
                                    "value": value,
                                    "text": jsonData[i].text
                                });
                            }
                            renderTransactionTable(1);
                            overlay.style.display = "none";
                        },
                    error:
                        function (response) {
                            console.log(response);
                            overlay.style.display = "none";
                            showErrorMessage("Error: " + response.statusText);
                        }
                }
            );
        }
        function renderTransactionTable(page = 1) {
            const tbody = document.querySelector("#tableTransactionIdx");
            if (!tbody) return;

            const start = (page - 1) * 10;
            const end = start + 10;
            const pageData = transactiontableData.slice(start, end);
            let rows = '';
            pageData.forEach(item => {
                rows += `
                    <tr>
                        <td>${item.text}</td>
                        <td>${item.value}</td>
                    </tr>
                `;
                //tbody.insertAdjacentHTML("beforeend", row);
            });
            $('#tableTransactionIdx').empty();
            tbody.insertAdjacentHTML("beforeend", rows);
        }
        function ShowBalance() {
            //if (@ViewBag.CustomerType == "2") {
            var urls = '@Url.Action("GetCustomerBalance", "Customer")';
            $.ajax({
                type: 'GET',
                url: urls,
                dataType: 'json', // changing data type to json
                success: function (data) { // here I'm adding data as a parameter which stores the response
                    //console.log(data); // instead of alert I'm changing this to console.log which logs all the response in console.
                    $('#lblbalance').html(data);
                },
                error: function (err) {
                    console.log(err);
                }
            });
            //}
        }
    </script>
    
    
</body>

