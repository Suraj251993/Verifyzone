<!DOCTYPE html>
<html lang="en">
@{
    string? currentPage = Convert.ToString(@ViewData["page"]);
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ex-zone Dashboard | Verifyzone</title>
    <link rel="icon" href="~/assets/img/logotop.png" />
    <link href="/assets/remix/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/sidebar.css">
    <link rel="stylesheet" href="~/assets/css/dash.css">
    <link rel="stylesheet" href="~/assets/css/exit-details.css">
    <link rel="stylesheet" href="~/assets/css/toast.css" asp-append-version="true">
    <link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <script src="/assets/bootstrap/js/bootstrap.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600&family=IBM+Plex+Sans:wght@400;600&display=swap"
          rel="stylesheet">
    <script src="~/assets/js/common.js?ver=2" asp-append-version="true"></script>    
    <script src="~/assets/js/jquery-3.7.1.min.js"></script>
    <style type="text/css" nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
        .form-loader-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.621);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 999;
            border-radius: 10px;
        }
    </style>
</head>


<body class="theme-cyan">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-top">
            <div class="notification-logo sidebar-items">
                <img src="~/assets/img/V.png" alt="Small Logo" class="logo-small">
                <img src="~/assets/img/white-logo.png" alt="Full Logo" class="logo-full">
            </div>
        </div>
        <div class="sidebar-scroll">
            <div class="sidebar-menu">
                <a href="/Customer/Index" class="sidebar-items @(currentPage == "HomeDashboard" ? "active" : "")">
                    <i class="ri-dashboard-line"></i>
                    <span class="menu-text">Dashboard</span>
                </a>
                <div class="sidebar-dropdown @(currentPage.StartsWith("EEV") ? "active open" : "")">
                    <div class="sidebar-items @(currentPage.StartsWith("EEV") ? "open" : "") sidebar-items1 dropdown-toggle1">
                        <i class="ri-user-add-line"></i>
                        <span class="menu-text">Add Employee Exit</span>
                        <i class="ri-arrow-down-s-line arrow-icon"></i>
                    </div>
                    <div class="dropdown-content @(currentPage.StartsWith("EEV") ? "open" : "")">
                        <a href="/Customer/EmployeeForm">
                            <div class="sidebar-subitem @(currentPage == "EEVForm" ? "active" : "")"><i class="ri-user-add-line"></i> Add an Exit</div>
                        </a>
                        <a href="/Customer/EmployeeUpload">
                            <div class="sidebar-subitem @(currentPage == "EEVUpload" ? "active" : "")"><i class="ri-upload-cloud-line"></i> Bulk upload</div>
                        </a>
                        @* <a href="#">
                            <div class="sidebar-subitem @(currentPage == "EEVVRequest" ? "active" : "")"><i class="ri-notification-2-line"></i> API sync</div>
                        </a> *@
                    </div>
                </div>
                <div class="sidebar-dropdown @(currentPage.StartsWith("EEAR") ? "active open" : "")">
                    <div class="sidebar-items @(currentPage.StartsWith("EEAR") ? "open" : "") sidebar-items1 dropdown-toggle1">
                        <i class="ri-user-follow-line"></i>
                        <span class="menu-text">Approve Requests</span>
                        <i class="ri-arrow-down-s-line arrow-icon"></i>
                    </div>
                    <div class="dropdown-content @(currentPage.StartsWith("EEAR") ? "open" : "")">
                        <a href="/Customer/EmployeeApproval">
                            <div class="sidebar-subitem @(currentPage == "EEARVerify" ? "active" : "")"><i class="ri-user-follow-line"></i> Re-verification</div>
                        </a>
                        <a href="/Customer/EmployeeRequest">
                            <div class="sidebar-subitem @(currentPage == "EEARRequest" ? "active" : "")"><i class="ri-notification-2-line"></i> New requests</div>
                        </a>
                        @* <a href="/Customer/ManagerApproval">
                            <div class="sidebar-subitem @(currentPage == "EEVVMgrAppr" ? "active" : "")"><i class="ri-group-2-line"></i> Manager approval</div>
                        </a> *@
                    </div>
                </div>
                <div class="sidebar-dropdown @(currentPage.StartsWith("EEW") ? "active open" : "")">
                    <div class="sidebar-items @(currentPage.StartsWith("EEW") ? "open" : "") sidebar-items1 dropdown-toggle1">
                        <i class="ri-notification-2-line"></i>
                        <span class="menu-text">Search Exit Records</span>
                        <i class="ri-arrow-down-s-line arrow-icon"></i>
                    </div>
                    <div class="dropdown-content @(currentPage.StartsWith("EEW") ? "open" : "")">
                        <a href="/Customer/ViewEmployee">
                            <div class="sidebar-subitem @(currentPage == "EEWEmployees" ? "active" : "")"><i class="ri-user-follow-line"></i> View records</div>
                        </a>
                        <a href="/Customer/SearchEmployee">
                            <div class="sidebar-subitem @(currentPage == "EEWEmp" ? "active" : "")"><i class="ri-notification-2-line"></i> Search a record</div>
                        </a>
                    </div>
                </div>
                
               @*  <a href="/Customer/ManagerApproval" class="sidebar-items">
                    <i class="ri-group-2-line"></i>
                    <span class="menu-text">Ex-employee approval</span>
                </a>
                <a href="managehr.html" class="sidebar-items">
                    <i class="ri-user-voice-line"></i>
                    <span class="menu-text">Manage user</span>
                </a> *@
                <div class="sidebar-dropdown @(currentPage.StartsWith("CONRV") ? "active open" : "")">
                    <div class="sidebar-items @(currentPage.StartsWith("CONRV") ? "open" : "") sidebar-items1 dropdown-toggle1">
                        <i class="ri-rocket-line"></i>
                        <span class="menu-text">Autopilot Approval</span>
                        <i class="ri-arrow-down-s-line arrow-icon"></i>
                    </div>
                    <div class="dropdown-content @(currentPage.StartsWith("CONRV") ? "open" : "")">
                        <a href="/Customer/AutoApprovalConfig">
                            <div class="sidebar-subitem @(currentPage == "CONRVAC" ? "active" : "")"><i class="ri-rocket-line"></i> Setup Autopilot</div>
                        </a>
                        <a href="/Customer/AutoApprovalExclude">
                            <div class="sidebar-subitem @(currentPage == "CONRVAE" ? "active" : "")"><i class="ri-rocket-line"></i> Setup Exclusions</div>
                        </a>
                    </div>
                </div>
                                
                <div class="sidebar-dropdown @(currentPage.StartsWith("ERP") ? "active open" : "")">
                    <div class="sidebar-items  @(currentPage.StartsWith("ERP") ? "active" : "") sidebar-items1 dropdown-toggle1">
                        <i class="ri-bar-chart-2-line"></i>
                        <span class="menu-text">Reports</span>
                        <i class="ri-arrow-down-s-line arrow-icon"></i>
                    </div>
                    <div class="dropdown-content @(currentPage.StartsWith("ERP") ? "open" : "")">
                        <a href="/Customer/AttritionReport">
                            <div class="sidebar-subitem @(currentPage == "ERPAR" ? "active" : "")"><i class="ri-line-chart-line"></i> Attrition Report</div>
                        </a>
                        <a href="/Customer/ApprovalHistory">
                            <div class="sidebar-subitem @(currentPage == "ERPVHIS" ? "active" : "")"><i class="ri-history-line"></i> Re-verification History</div>
                        </a>
                        @* <a href="/Customer/ManagerStatus">
                            <div class="sidebar-subitem @(currentPage == "EEVVerify" ? "active" : "")"><i class="ri-user-follow-line"></i> Manager Approval Status</div>
                        </a> *@
                    </div>
                </div>
                <a href="/Customer/EmployeeConsent" class="sidebar-items @(currentPage == "ECM" ? "active" : "")">
                    <i class="ri-shield-check-line"></i>
                    <span class="menu-text">Employee Consent</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Right Content -->
    <div class="main-container">
        <div class="navbar">
            <div class="navbar-left d-flex">
                <div class="navbar-ex-toggle">
                    <input type="checkbox" id="exswitch">
                    <label for="exswitch" class="exzone-slider">
                        <span class="ex-nav-text on">
                            <img src="~/assets/img/ex-zone.png" alt=""
                                 style="width: 70px;">
                        </span>
                        <span class="ex-nav-text off" data-bs-toggle="modal" data-bs-target="#switchPage">
                            <img src="~/assets/img/v-zone-logo-W-png.png" alt="" style="width: 70px;">
                        </span>
                    </label>
                </div>
                <div class="modal fade" id="switchPage" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
                     aria-labelledby="staticBackdropLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header border-0">
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-center">
                                <h5 class="logout-popup-dahx-icon">
