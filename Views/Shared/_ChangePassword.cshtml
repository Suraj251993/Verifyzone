@{
}
@model OrgCheck.ViewModels.ChangePassword
<div class="modal fade" id="modalChpass" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalLabel">Change Password</h5>
            </div>
            <div class="modal-body">
                <form id="frmchpass" name="frmchpass">
                    <div class="form-group form-float">
                        <div id="divoldpwd" class="form-line">
                            @Html.PasswordFor(model => model.OldPassword, new { @class = "form-control", @type = "password" })
                            <label class="form-label">Old Password</label>
                        </div>
                    </div>
                    <div class="form-group form-float">
                        <div id="divnewpwd" class="form-line">
                            @Html.PasswordFor(model => model.NewPassword, new { @class = "form-control", @type = "password" })
                            <label class="form-label">New Password</label>
                        </div>
                    </div>
                    <div class="form-group form-float">
                        <div id="divconfirmpwd" class="form-line">
                            @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control", @type = "password" })
                            <label class="form-label">Confirm Password</label>
                        </div>
                    </div>                    
                </form>
            </div>
            <div class="modal-footer">
                <input type="button" class="btn btn-link waves-effect" value="Save" id="ChPassSave" name="Save" />
                <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

