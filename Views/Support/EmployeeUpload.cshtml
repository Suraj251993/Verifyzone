@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model OrgCheck.ViewModels.UploadViewModel
@{
    Layout = "~/Views/Shared/_SupportLayout.cshtml";
}
<link rel="stylesheet" href="~/assets/css/dash.css" asp-append-version="true">
<link rel="stylesheet" href="~/assets/css/exit-details.css" asp-append-version="true">
<link rel="stylesheet" href="~/assets/css/bulk.css" asp-append-version="true">
<link rel="stylesheet" href="/assets/css/verification-request.css" asp-append-version="true">
<style>
    .RGraph_tooltip li {
        text-align: left;
        margin: 3px;
    }

    .RGraph_tooltip h2 {
        color: white;
        margin: 5px;
        font-style: italic;
    }
</style>
<script src="~/js/RGraph.common.core.js"></script>
<script src="~/js/RGraph.common.dynamic.js"></script>
<script src="~/js/RGraph.common.key.js"></script>
<script src="~/js/RGraph.drawing.rect.js"></script>
<script src="~/js/RGraph.pie.js"></script>

<div class="breadcrumbs" style="padding: 10px 0px 20px 5px"><a href="/Support/Index"><i
        class="ri-home-8-line" style="color: var(--purple-color)"></i></a> <i class="ri-arrow-right-s-line"
    style="color: var(--purple-color)"></i> <span style="font-size: 14px;">Employee bulk upload</span>
</div>

<div class="bulk-upload-card mb-3 shadow-sm">
    <h5 class="bulk-table-heading mb-4">Employee bulk upload</h5>
    <div class="wf-flow">
        <div class="wf-step active" id="wfStep1"><span class="wf-step-num">1</span><span class="wf-step-label">Upload</span></div>
        <div class="wf-connector" id="wfConnector1"></div>
        <div class="wf-step" id="wfStep2"><span class="wf-step-num">2</span><span class="wf-step-label">Review &amp; confirm</span></div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <form enctype="multipart/form-data" id="frm" name="frm">
                <div class="row align-items-end">
                    <div class="col-md-5">
                        <div class="form-group">
                            <label class="usernameLabel d-block mb-1">Choose HR user</label>
                            @Html.DropDownListFor(model => model.user, (IEnumerable<SelectListItem>)ViewBag.Users, "Please choose HR user", new { @class = "form-control", @id = "mddusertype" })
                            @* @Html.DropDownList("users", (IEnumerable<SelectListItem>)ViewBag.Users, "Please choose HR user", new { @class = "form-control" }) *@
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group">
                            <label class="usernameLabel d-block mb-1">Choose file</label>
                            <div class="drop-area d-flex flex-column justify-content-center align-items-center">
                                <p class="file-prompt mb-1"><i class="ri-upload-cloud-2-line fs-3"></i></p>
                                @Html.TextBoxFor(model => model.file, new { type = "file", name = "file"})
                                @* <input type="file" name="file" id="file" /> *@
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 mb-3">
                        <button type="button" class="btn-submit w-100" id="btnupload" name="btnupload">
                            <div class="original">Upload</div>
                            <div class="letters">
                                <span>U</span><span>p</span><span>l</span><span>o</span><span>a</span><span>d</span>
                            </div>
                        </button>
                    </div>
                </div>
                @* <div id="dialog" style="display: none">
                    </div>*@
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-2">
        <a href="#" id="downloadtemplate" name="downloadtemplate" class="btn-submit">
            <div class="original"><i class="ri-download-2-line me-1"></i> Download template</div>
            <div class="letters">
                <span>D</span><span>o</span><span>w</span><span>n</span><span>l</span><span>o</span><span>a</span><span>d</span>
                <span class="ms-1"></span>
                <span>t</span><span>e</span><span>m</span><span>p</span><span>l</span><span>a</span><span>t</span><span>e</span>
            </div>
        </a>
    </div>
</div>

<div class="content pt-0">
    <h5 class="bulk-table-heading mb-2">Upload history</h5>
    <div class="card p-0 mt-3 mb-4 border-0 exz-table-card">
        <div class="table-responsive">
            <table id="latestupload" class="display table nowrap table-striped table-hover" style="width:100%">
                <thead style="background: #f4f1f8">
                    <tr>
                        <th>Filename</th>
                        <th>Uploaded date</th>
                        <th>Status</th>
                        <th>Valid records</th>
                        <th>Invalid records</th>
                        <th>Total records
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>


<div id="partialModal" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title bulk-table-heading">Upload summary</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="au-card m-b-30">
                            <div class="au-card-inner">
                                @*<h3 class="title-2 m-b-40">Upload Summary</h3>*@
                                <input type="hidden" id="flid" name="flid" />
                                <input type="hidden" id="svtotal" name="svtotal" />
                                <canvas id="cvs" width="650" height="400">[No canvas support]</canvas>
                            </div>
                        </div>
                    </div>
                    @*<div class="col-lg-6">
                            <div class="au-card m-b-30">
                                <div class="au-card-inner">
                                    <h5 class="title-2 m-b-40">Total records: <span id="stotal"></span></h5>
                                    <h5 class="title-2 m-b-40">Valid records: <span id="svtotal"></span></h5>
                                    <h5 class="title-2 m-b-40">Invalid records: <span id="sivtotal"></span></h5>
                                </div>
                            </div>
                        </div>*@
                </div>                
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button id="Approve" type="button" class="verify-button-approve" data-dismiss="modal" onclick="ApprovedorRejectedFile(this.id)">
                    <i class="ri-upload-cloud-2-line"></i> Approve
                </button>
                <button id="Reject" type="button" class="verify-button-reject" data-dismiss="modal" onclick="ApprovedorRejectedFile(this.id)">
                    <i class="ri-close-line"></i> Reject
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts
{


    @await Html.PartialAsync("/Views/Shared/_ValidationScriptsPartial.cshtml")
    <script src="~/vendor/chartjs/Chart.bundle.min.js"></script>
    <script>
        $(function () {
            $("#latestupload").dataTable();
            $('#loading').hide();
        })
    $(document).ready(function () {
        //BindFileUploads();
    });
        $('#btnupload').click(function () {
            $('#loading').show();
            var userId = $('#mddusertype option:selected').val();
            
            if (userId == '' || userId == null)
                userId = "0";
            if (userId == "0") {
                $('#loading').hide();
                showErrorMessage("Please choose HR user before upload");
                return;
            }
            var files = $('#file').prop("files");
            if (files[0] == null || files[0] == '') {
                $('#loading').hide();
                showErrorMessage("Please choose file before upload");
                return;
            }

            var url = '@Url.Action("EmployeeUpload", "Support")';
            var type = 'POST';
            var formData = new FormData();            
            formData.append("file", files[0]);
            formData.append("user", userId.toString());
            console.log(formData);
            $.ajax({
                url: url,
                type: type,
                data: formData,
                dataType: "json",
                enctype: "multipart/form-data",
                processData: false,
                contentType: false,
                error: function (xhr) {
                    console.log(xhr);
                    alert('Error: ' + xhr.statusText);
                },
                success: function (response) {
                    $('#loading').hide();
                    if (response != null || response != "") {
                        //$('#partialModal').html(response);
                        //$('#stotal').text(response.totalrecords);
                        $('#svtotal').val(response.validrecords);
                        //$('#sivtotal').text(response.invalidrecords);
                        $('#flid').val(response.fileid);

                        new RGraph.Pie({
                            id: 'cvs',
                            data: [response.totalrecords, response.validrecords, response.invalidrecords],
                            options: {
                                key: ['Total Records : ' + response.totalrecords + '', 'Valid Records : ' + response.validrecords + '', 'Invalid Records : ' + response.invalidrecords + ''],
                                keyInteractive: true,
                                colors: ["#3498eb", "#a8eb34", "#eb5334"],
                                radius: 150
                            }
                        }).draw();
                        $("#partialModal").modal('show');
                    }
                    else {
                        showErrorMessage('Error occurred while uploading the file');
                    }

                },
                async: false,
                processData: false
            });
        });
        $('#downloadtemplate').click(function () {
            window.open("/Support/DownloadTemplate", '_blank');
        });
        function BindFileUploads() {
            $('#loading').show();
            var userId = $('#users option:selected').val();
            if (userId == '' || userId == null)
                userId = 0;
            $.ajax(
                {
                    type: 'GET',
                    dataType: 'JSON',
                    data: { user: userId },
                    url: '@Url.Action("GetLatestUploads", "Support")',
                    success:
                        function (jsonData) {
                            $('#latestupload').DataTable({
                                pagination: "bootstrap",
                                filter: true,
                                data: jsonData,
                                destroy: true,
                                lengthMenu: [5, 10, 25],
                                pageLength: 10,
                                "columns": [
                                    { "data": "filename", "filename": "Filename", "autoWidth": true },
                                    { "data": "uploadeddate", "uploadeddate": "Uploaded date", "autoWidth": true },
                                    { "data": "uploadedstatus", "name": "uploadedstatus", "Uploaded status": true },
                                    { "data": "validrecords", "validrecords": "Valid records", "autoWidth": true },
                                    { "data": "invalidrecords", "invalidrecords": "Invalid records", "autoWidth": true },
                                    { "data": "totalrecords", "totalrecords": "Total records", "autoWidth": true },
                                ]
                            });
                        },
                    error:
                        function (response) {
                            alert("Error: " + response);
                        }
                }
            );
            $('#loading').hide();
        }

        function ApprovedorRejectedFile(mode) {
            var model = { "Mode": mode, "FileId": $('#flid').val() };
            if (mode == "Approve" && $('#svtotal').val() == 0) {
                showErrorMessage("No valid records to approve. Please reject the file.");
                return;
            }
            $.ajax({
                type: "POST",
                url: '@Url.Action("ApproveorRejectFile", "Support")',
                data: JSON.stringify(model),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    console.log(result); // = 'test'
                    if (result == true) {
                        if (mode == "Approve")
                            showSuccessMessage('File uploaded successfully.');
                        else
                            showSuccessMessage('File rejected successfully.');
                        BindFileUploads();
                    }
                    else {
                        showErrorMessage('Error while uploading the file');
                    }
                }
            });
        }
    </script>
    <script>
        // Purely visual: reflect upload/review progress on the step indicator above the upload card.
        $(function () {
            $('#partialModal').on('shown.bs.modal', function () {
                document.getElementById("wfStep2").classList.add("active");
                document.getElementById("wfConnector1").classList.add("active");
            });
            $('#partialModal').on('hidden.bs.modal', function () {
                document.getElementById("wfStep2").classList.remove("active");
                document.getElementById("wfConnector1").classList.remove("active");
            });
        });
    </script>
}