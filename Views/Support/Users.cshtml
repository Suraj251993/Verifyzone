@{
    Layout = "~/Views/Shared/_SupportLayout.cshtml";
}
<link rel="stylesheet" href="~/assets/css/dash.css" asp-append-version="true">
<link rel="stylesheet" href="~/assets/css/exit-details.css" asp-append-version="true">

<div class="breadcrumbs" style="padding: 10px 0px 20px 5px"><a href="/Support/Index"><i
        class="ri-home-8-line" style="color: var(--purple-color)"></i></a> <i class="ri-arrow-right-s-line"
    style="color: var(--purple-color)"></i> <span style="font-size: 14px;">Users</span>
</div>

<div class="content">
    <div class="exz-page-head">
        <h1>Users</h1>
        <p>Look up users by type and reset their password when needed.</p>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-8 exz-filter-card">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="form-group">
                        @Html.DropDownList("searchusertype", (IEnumerable<SelectListItem>)ViewBag.SearchUserTypes, "Please choose UserType", new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn-submit border-0" id="getusers" name="getusers" disabled>
                        <div class="original">Get Users</div>
                        <div class="letters">
                            <span>G</span>
                            <span>e</span>
                            <span>t</span>
                            <span class="ms-1"></span>
                            <span>U</span>
                            <span>s</span>
                            <span>e</span>
                            <span>r</span>
                            <span>s</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="card p-0 mt-3 mb-4 border-0 exz-table-card">
        <div class="table-responsive">
            <table id="userMaster" class="display table nowrap table-striped table-hover" style="width:100%">
                <thead style="background: #f4f1f8">
                    <tr>
                        <th>Name</th>
                        <th>Login name</th>
                        <th>Designation</th>
                        <th>Email</th>
                        <th>Contact #</th>
                        <th>Reset</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts
{
    @await Html.PartialAsync("/Views/Shared/_ValidationScriptsPartial.cshtml")
<script>
        $(function () {
            $('#loading').hide();
        })

        $('#searchusertype').change(function () {
            var id = $('#searchusertype option:selected').val();
            $("#getusers").prop("disabled", id == 'Please choose UserType');
        });
        $('#getusers').click(function (e) {
            $('#loading').show();
            BindUsers();
            $('#loading').hide();
        });

        function BindUsers() {
            var usertypeId = $('#searchusertype option:selected').val();
            if (usertypeId == 0)
                showErrorMessage('Select Usertype ');
            else {
                $.ajax(
                    {
                        type: 'GET',
                        dataType: 'JSON',
                        url: '@Url.Action("GetUsers", "Admin")',
                        data: { usertypeId: usertypeId },
                        success:
                            function (response) {
                                // Generate HTML table.
                                setUserToTable(response);
                                //convertJsonToHtmlTable(JSON.parse(response), $("#cityMaster"));
                            },
                        error:
                            function (response) {
                                alert("Error: " + response);
                            }
                    }
                );
            }
        }
        function setUserToTable(jsonData) {
            //console.log(jsonData);
            $('#userMaster').DataTable({
                pagination: "bootstrap",
                filter: true,
                data: jsonData,
                destroy: true,
                lengthMenu: [5, 10, 25],
                pageLength: 10,
                "columns": [
                    { "data": "displayname", "name": "Name", "autoWidth": true },
                    { "data": "loginname", "name": "Login name", "autoWidth": true },
                    { "data": "designation", "name": "Designation", "autoWidth": true },
                    { "data": "emailid", "name": "Email ID", "autoWidth": true },
                    { "data": "contactnumber", "name": "Contact #", "autoWidth": true },
                    {
                        "render": function (data, type, full, meta) { return '<div onclick="ResetUser(' + full.id + ')"><a href="#"><i class="fas fa-sync-alt"></i></a></div>'; }
                    },
                ]
            });
        }
        
        function ResetUser(userId) {
            $('#loading').show();
                $.ajax({
                    type: 'GET',
                    dataType: 'JSON',
                    url: '@Url.Action("ResetUser", "Support")',
                    data: { id: userId.toString() },
                    success:
                        function (response) {
                            $('#loading').hide();
                            if (response == true) {
                                showSuccessMessage("The password was reset and sent to the respective user");
                            }
                            else {
                                showErrorMessage("Error occurred while reset the password. Please contact support");
                            }
                        },
                    error:
                        function (response) {
                            console.log(response);
                            $('#loading').hide();
                            alert("Error: " + response);
                        }
                });
            };
       
</script>
}
