                                <span>Re-verification history</span>
                                <span class="login-preview-badge info">Generating</span>
                            </div>
                            <div class="login-preview-list-row">
                                <span>Approval summary &ndash; Q3</span>
                                <span class="login-preview-badge success">Ready</span>
                            </div>
                        </div>
                    </div>

                    <div class="login-preview-nav">
                        <span class="login-preview-navdot navdot-1"></span>
                        <span class="login-preview-navdot navdot-2"></span>
                        <span class="login-preview-navdot navdot-3"></span>
                    </div>
                </div>

                <ul class="login-highlights">
                    <li><i class="ri-shield-check-line"></i> Fast, reliable background verification</li>
                    <li><i class="ri-user-search-line"></i> Track requests end-to-end in one place</li>
                    <li><i class="ri-line-chart-line"></i> Real-time verification analytics</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="modal fade" id="forgetpopup" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
         aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h1 class="modal-title bulk-table-heading" id="staticBackdropLabel">Forgot password</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="inputContainer">
                        <input required="required" class="input-container" autocomplete="off"
                               placeholder="Please enter your registered email" type="text" id="txtemail">
                        <label class="usernameLabel">Please enter your registered email</label>
                        <i class="ri-mail-line userIcon"></i>
                        <span class="validationMessage" id="forgotvalidationMessage"
                              style="display:none;">
                            *Please
                            enter registered email
                        </span>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"
                            style="padding: 3px 20px;">
                        Close
                    </button>

                    <button class="btn-submit" type="button" name="Submit" value="Submit" id="Submit">
                        <div class="original">Submit</div>
                        <div class="letters">
                            <span>S</span>
                            <span>u</span>
                            <span>b</span>
                            <span>m</span>
                            <span>i</span>
                            <span>t</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modals -->
<div id="error" class="toast-modal">
    <div class="modal-content model-toast error">
        <div class="modal-header border-0">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="icon"><i class="ri-close-line"></i></div>

        <p id="errormessage"></p>
    </div>
</div>

<script src="~/assets/js/popper.min.js"></script>
<script src="~/assets/bootstrap/js/bootstrap.min.js"></script>
<script src="~/assets/js/pages/login.js?ver=1" asp-append-version="true"></script>
<script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
    $(function () {
        document.getElementById("Submit").addEventListener("click", forgotPassword);
        document.getElementById("error").addEventListener("click", function() {
                closeModal(this);
            });
        
        function forgotPassword() {    
            var _url = '@Url.Action("ForgotPassword", "Home")';
            //$('.loader').show();
            $.ajax({
                type: 'GET',
                dataType: 'JSON',
                url: _url,
                data: { emailId: $("#txtemail").val().trim() },
                success:
                    function (result) {

                        if (result == true) {
                            // Show success toast message
                            showSuccessMessage('Request sent to the support team. You will be notified soon.');
                        }
                        else {
                            // Show success toast message
                            showErrorMessage('User not found');
                        }
                        $("#txtemail").val('');
                        $("#smallModal").modal('hide');
                    },
                error:
                    function (response) {
                        showErrorMessage("Error: " + response.statusText);
                    }
            });
        }        
    })
</script>