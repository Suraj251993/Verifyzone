                                <div class="login-preview-bar" style="height:38%"></div>
                                <div class="login-preview-bar" style="height:90%"></div>
                                <div class="login-preview-bar" style="height:60%"></div>
                                <div class="login-preview-bar" style="height:80%"></div>
                                <div class="login-preview-bar" style="height:55%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="login-preview-card slide-2">
                        <div class="login-preview-head">
                            <span class="login-preview-dot"></span>
                            <span class="login-preview-dot"></span>
                            <span class="login-preview-dot"></span>
                            <span class="login-preview-head-title">V-Zone dashboard</span>
                        </div>
                        <div class="login-preview-kpis">
                            <div class="login-preview-kpi">
                                <div class="login-preview-kpi-num">184</div>
                                <div class="login-preview-kpi-label">Downloads</div>
                            </div>
                            <div class="login-preview-kpi">
                                <div class="login-preview-kpi-num">312</div>
                                <div class="login-preview-kpi-label">Searches</div>
                            </div>
                            <div class="login-preview-kpi">
                                <div class="login-preview-kpi-num">42</div>
                                <div class="login-preview-kpi-label">Credits left</div>
                            </div>
                        </div>
                        <div class="login-preview-body login-preview-donut-row">
                            <div class="login-preview-donut"></div>
                            <div class="login-preview-legend">
                                <div class="login-preview-legend-row"><span class="dot dot-1"></span>Verified <b>68%</b></div>
                                <div class="login-preview-legend-row"><span class="dot dot-2"></span>In progress <b>20%</b></div>
                                <div class="login-preview-legend-row"><span class="dot dot-3"></span>Flagged <b>12%</b></div>
                            </div>
                        </div>
