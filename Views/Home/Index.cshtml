                        <div class="login-preview-kpis">
                            <div class="login-preview-kpi">
                                <div class="login-preview-kpi-num">96%</div>
                                <div class="login-preview-kpi-label">On-time</div>
                            </div>
                            <div class="login-preview-kpi">
                                <div class="login-preview-kpi-num">18</div>
                                <div class="login-preview-kpi-label">Reports</div>
                            </div>
                            <div class="login-preview-kpi">
                                <div class="login-preview-kpi-num">4.2d</div>
                                <div class="login-preview-kpi-label">Avg. TAT</div>
                            </div>
                        </div>
                        <div class="login-preview-body login-preview-list">
                            <div class="login-preview-list-row">
                                <span>Attrition report &ndash; Aug</span>
                                <span class="login-preview-badge success">Ready</span>
                            </div>
