@{
    Layout = null;
}

@section VendorScripts {
    <script src="~/js/common.js"></script>
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Verifyzone</title>
    <link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <script src="~/assets/bootstrap/js/bootstrap.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600&family=IBM+Plex+Sans:wght@400;600&display=swap"
          rel="stylesheet">
    <link rel="icon" href="~/assets/img/logotop.png" />
    <link href="~/assets/css/login.css" rel="stylesheet">
    <!-- Include Remix Icons CDN -->
    <link href="/assets/remix/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/landing.css">
    <link rel="stylesheet" href="~/assets/css/dash.css">
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600&family=IBM+Plex+Sans:wght@400;600&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/sidebar.css">
    <link rel="stylesheet" href="~/assets/css/exit-details.css">
    <script src="~/assets/js/jquery-3.7.1.min.js" asp-append-version="true"></script>
</head>
<body>
    <div class="container pt-3">
        <div class="dashboard-main">
            <div class="navbar">
                <div class="navbar-left">
                    <img src="~/assets/img/logo-dash.png" alt="Logo" class="logo">
                </div>
                <div class="navbar-right">
                    <div class="profile">
                        <div class="dropdown">
                            <button class="dropdown-btn profile-wrapper">
                                <img src="~/assets/img/profile-nav.jpg" alt="Profile" class="profile-img">
                                <span class="active-indicator"></span>
                            </button>
                            <div class="dropdown-menu border-0">
                                <div class="border-bottom d-flex gap-1 px-2">
                                    <div class="profile-wrapper1">
                                        <img src="~/assets/img/profile-nav.jpg" alt="Profile" class="profile-img-sub">
                                        <span class="active-indicator1"></span>
                                    </div>
                                    <p class="pt-1">@User.Identity.Name</p>
                                </div>
                                @* <a href="adminDashboard.html" class="drop-profile-items">
                                    <i class="ri-logout-box-r-line"></i> Go to admin
                                </a>
                                <a href="institutionDashboard.html" class="drop-profile-items">
                                    <i class="ri-building-2-line"></i> Institution 
                                </a>
                                <a href="toast.html" class="drop-profile-items">
                                    <i class="ri-chat-1-line"></i> Toast messages
                                </a>
                                <a href="403.html" class="drop-profile-items">
                                    <i class="ri-error-warning-line"></i> 403
                                </a>
                                <a href="404.html" class="drop-profile-items">
                                   <i class="ri-arrow-right-circle-line"></i> 404
                                </a>
                                <a href="itsupportDashboard.html" class="drop-profile-items">
                                   <i class="ri-customer-service-line"></i> IT support
                                </a> *@
                                <a class="drop-profile-items" style="color: red;" data-bs-toggle="modal"
                                    data-bs-target="#staticBackdrop">
                                    <i class="ri-logout-box-r-line"></i> Logout
                                </a>
                            </div>
                        </div>
                        <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false"
                            tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header border-0">
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-center">
                                        <h5 class="logout-popup-dahx-icon"><i class="ri-logout-circle-line"></i></h5>
                                        <h6 class="logout-popup-dahx">Are you sure <br>
                                            You want to log-out ?</h6>
                                    </div>
                                    <div class="modal-footer border-0 justify-content-center">
                                        <button class="btn-closes" data-bs-dismiss="modal">
                                            <div class="original">No</div>
                                            <div class="letters">
                                                <span>N</span>
                                                <span>o</span>
                                            </div>
                                        </button>&nbsp;&nbsp;                                        
                                        <button class="btn-submit" id="logout-btn" type="button" name="next">
                                            <div class="original">Yes</div>
                                            <div class="letters">
                                                <span>Y</span>
                                                <span>e</span>
                                                <span>s</span>
                                            </div>
                                        </button>                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="dashboard-content">
                <div class="row justify-content-center align-items-center gap-4 p-2">

                    <div class="col-md-4 mt-4">
                        <div class="landing-note-card landing-orange-card">
                            <div class="landing-pin"></div>
                            <img src="~/assets/img/ex-zone.png" class="landing-zone-img" alt="V-Zone">
                            <p class="mt-2" style="text-align: justify;">
                                Ex-Zone helps you manage employee exit processes smoothly. Track clearance
                                stages, verify documents, update relieving details, and maintain complete
                                exit records .
                                 <!-- in one centralized module. -->
                            </p>

                            <a href="/Customer/Index" style="text-decoration: none;">
                                <button class="landing-explore-btn">
                                    Explore Now
                                    <i class="ri-arrow-right-line"></i>
                                </button>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4 mt-4">
                        <div class="landing-note-card landing-blue-card">
                            <div class="landing-pin"></div>                            
                            <img src="~/assets/img/v-zone.png" alt="v-zone" class="landing-zone-img">
                            <p class="mt-2">
                                V-Zone is a unified verification module that supports employment checks,
                                education verification, classified document reviews, and automated report
                                generation.
                            </p>


                            <a href="/Customer/VIndex" style="text-decoration: none;">
                                <button class="landing-explore-btn1">
                                    Explore Now
                                    <i class="ri-arrow-right-line"></i>
                                </button>
                            </a>
                        </div>
                    </div>


                </div>
            </div>
            <div class="footer pt-3" style="font-size: 12px;">
                <p>2026 <span style="color:var(--purple-color)">Tarajyau</span> | All Rights Reserved</p>
            </div>
        </div>
    </div>
    <script src="~/assets/js/popper.min.js"></script>    
    <script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
        document.getElementById("logout-btn").addEventListener("click", logout);
        function logout() {
                $.ajax({
                    type: 'GET',
                    url: "/Home/Logout",
                    dataType: 'json', // changing data type to json
                    success: function (data) { // here I'm adding data as a parameter which stores the response
                        //console.log(data); // instead of alert I'm changing this to console.log which logs all the response in console.
                        if (data == true)
                            window.location = "/";
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            }
    </script>
</body>
