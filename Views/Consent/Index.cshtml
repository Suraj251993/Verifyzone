@model OrgCheck.ViewModels.ConsentTokenViewModel
@{
    Layout = null;
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Consent | Verifyzone</title>

    <link rel="icon" href="~/assets/img/logotop.png" />
    <link href="~/assets/css/login.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/toast.css" asp-append-version="true">
    <link href="~/assets/css/exit-details.css" rel="stylesheet">
    <link href="/assets/remix/fonts/remixicon.css" rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600&family=IBM+Plex+Sans:wght@400;600&display=swap"
        rel="stylesheet">
    <link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <script src="/assets/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/common.js?ver=1" asp-append-version="true"></script>
    <script src="~/assets/js/jquery-3.7.1.min.js" asp-append-version="true"></script>
</head>
<div class="login-bg"></div>

<div class="container lcon">
    <div class="login-container">
        <div class="login-left" id="consentBox" style="width: 100%;">
            <img src="~/assets/img/logotop.png" alt="Company logo" style="height: 48px; margin-bottom: 15px;" />

            @if (Model.Valid)
            {
                <h5 class="login-welcome">Employee Consent</h5>
                <p class="login-subtext">Hello @Model.Employeename,</p>
                <p class="login-subtext" id="consentStatement">
                    @Model.Companyname has requested your consent as part of their employment verification process.
                    Please review your details below, read the consent statement, and provide your response.
                </p>

                <form id="consentForm" autocomplete="off">
                    <input type="hidden" id="Token" value="@Model.Token" />
                    <div class="inputContainer" style="margin-top: 20px;">
                        <input class="input-container" type="text" value="@Model.Employeename" readonly="readonly" />
                        <label class="usernameLabel">Employee name</label>
                        <i class="ri-user-6-line userIcon"></i>
                    </div>
                    <div class="inputContainer" style="margin-top: 20px;">
                        <input class="input-container" type="text" value="@Model.Employeeemail" readonly="readonly" />
                        <label class="usernameLabel">Official email address</label>
                        <i class="ri-mail-line userIcon"></i>
                    </div>
                    <div class="inputContainer" style="margin-top: 20px; position: relative;">
                        <input id="Optionalemail" class="input-container" type="text" placeholder="Alternative email (optional)" autocomplete="off" />
                        <label class="usernameLabel">Alternative email address (optional)</label>
                        <i class="ri-mail-line userIcon"></i>
                        <i class="ri-information-line" id="altEmailTooltip" data-bs-toggle="tooltip" data-bs-placement="top"
                           title="You can provide an alternative personal email address for future communication and tracking purposes. If your official company email address becomes inactive after your employment ends, this email will help you continue accessing and tracking your consent records, employment verification status, and related updates."
                           style="position: absolute; right: 15px; top: 18px; cursor: pointer; color: var(--purple-color);"></i>
                    </div>

                    <div class="mt-4">
                        <button type="button" class="btn-submit" data-bs-toggle="modal" data-bs-target="#consentStatementModal" style="width: 100%;">
                            <div class="original"><i class="ri-file-text-line"></i>&nbsp; View Consent Statement</div>
                            <div class="letters"><span><i class="ri-file-text-line"></i>&nbsp; View Consent Statement</span></div>
                        </button>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-12">
                            <div class="checkbox-wrapper-12 d-flex gap-3" id="consentCheckboxWrapper" style="opacity: 0.5;">
                                <div class="cbx">
                                    <input type="checkbox" id="cbxconsent" disabled="disabled">
                                    <label for="cbxconsent"></label>
                                    <svg fill="none" viewBox="0 0 15 14" height="14" width="15">
                                        <path d="M2 8.36364L6.23077 12L13 2"></path>
                                    </svg>
                                </div>
                                <span>I have read, understood the consent statement, and provide my voluntary agreement.</span>
                            </div>
                            <p id="documentReviewMessage" style="color: var(--purple-color); font-size: 12px; margin-top: 5px;">
                                *Please open and review the consent statement above to enable this checkbox
                            </p>
                        </div>
                    </div>
                    <p id="consentValidationMessage" style="display:none; color: red; font-size: 13px; margin-top: 5px;">
                        *Please accept the consent statement before submitting
                    </p>
                    <div class="text-center mt-4">
                        <button type="button" id="btnsubmitconsent" class="btn btn-primary login-btn">Provide Consent</button>
                    </div>
                </form>

                <div id="consentSuccessBox" style="display:none; text-align:center; margin-top: 20px;">
                    <i class="ri-checkbox-circle-line" style="font-size: 48px; color: green;"></i>
                    <h5 class="login-welcome mt-3">Thank you.</h5>
                    <p class="login-subtext">Your consent has been successfully recorded. No additional action is required.</p>
                </div>
            }
            else if (Model.Consumed)
            {
                <div style="text-align:center; margin-top: 20px;">
                    <i class="ri-checkbox-circle-line" style="font-size: 48px; color: green;"></i>
                    <h5 class="login-welcome mt-3">Thank you.</h5>
                    <p class="login-subtext">Your consent has already been recorded. No additional action is required.</p>
                </div>
            }
            else if (Model.Expired)
            {
                <div style="text-align:center; margin-top: 20px;">
                    <i class="ri-time-line" style="font-size: 48px; color: var(--purple-color);"></i>
                    <h5 class="login-welcome mt-3">Link expired</h5>
                    <p class="login-subtext">This consent request has expired. Please contact your HR representative.</p>
                </div>
            }
            else
            {
                <div style="text-align:center; margin-top: 20px;">
                    <i class="ri-error-warning-line" style="font-size: 48px; color: var(--purple-color);"></i>
                    <h5 class="login-welcome mt-3">Invalid request</h5>
                    <p class="login-subtext">Invalid or unavailable consent request.</p>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.Valid)
{
    <div class="modal fade" id="consentStatementModal" data-bs-backdrop="static" data-bs-keyboard="false"
         tabindex="-1" aria-labelledby="consentStatementModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h1 class="modal-title bulk-table-heading fs-5" id="consentStatementModalLabel">
                        Employee Consent for Employment Verification
                    </h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6>Purpose of Consent</h6>
                    <p>
                        I understand that my employer may receive requests from authorized third parties, including
                        prospective employers, background verification companies, or other authorized organizations,
                        to verify my employment-related information.
                    </p>
                    <p>
                        By providing my consent, I authorize my employer to share relevant employment details for
                        verification purposes when requested by a legitimate third party.
                    </p>

                    <h6>Information Sharing</h6>
                    <p>The information shared may include employment-related details such as:</p>
                    <ul>
                        <li>Employment duration</li>
                        <li>Job title/designation</li>
                        <li>Department information</li>
                        <li>Employment status</li>
                        <li>Other relevant employment verification details required for verification purposes</li>
                    </ul>
                    <p>The information will only be shared for legitimate employment verification activities.</p>

                    <h6>Future Employer / Background Verification Process</h6>
                    <p>
                        I understand that a future employer or background verification company may request
                        verification of my previous employment details.
                    </p>
                    <p>
                        Upon receiving my consent and a valid verification request, my previous employer may provide
                        the required employment information.
                    </p>
                    <p>
                        The requesting organization may upload the verification request and related documents into
                        the V-Zone platform to access the verification report.
                    </p>

                    <h6>Transparency Statement</h6>
                    <p>
                        This consent process is designed to maintain transparency between the employee, previous
                        employer, and verification requesting organization.
                    </p>
                    <p>
                        By providing this consent, I acknowledge that my employment information may be shared with
                        authorized parties strictly for employment verification purposes.
                    </p>

                    <h6>Voluntary Agreement</h6>
                    <p>I confirm that:</p>
                    <ul>
                        <li>I have read and understood this consent statement.</li>
                        <li>I voluntarily provide my consent for employment verification purposes.</li>
                        <li>I understand that my consent enables my previous employer to share relevant employment details with authorized verification parties.</li>
                        <li>I understand that this consent may be used for future employment verification requests.</li>
                    </ul>
                    <p class="text-muted" style="font-size: 12px;">Document version: v1.0</p>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button class="btn-submit" type="button" data-bs-dismiss="modal">
                        <div class="original">I have reviewed this statement</div>
                        <div class="letters"><span>I have reviewed this statement</span></div>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modals -->
<div id="error" class="toast-modal">
    <div class="modal-content model-toast error">
        <div class="modal-header border-0">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="icon"><i class="ri-close-line"></i></div>
        <p id="errormessage"></p>
    </div>
</div>
<div id="success" class="toast-modal">
    <div class="modal-content model-toast success px-0 pb-0 p-0 m-0">
        <div class="icon"><i class="ri-check-line"></i></div>
        <p id="successmessage"></p>
        <div class="toast-progress progress" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
            <div class="toast-progress-bar" id="errorProgress"></div>
        </div>
    </div>
</div>

<script src="~/assets/js/popper.min.js"></script>
<script src="~/assets/js/pages/consentsubmit.js?ver=1" asp-append-version="true"></script>
<script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
    var csrfToken = '@Antiforgery.GetAndStoreTokens(Context).RequestToken';
    var submitConsentUrl = '@Url.Action("Submit", "Consent")';
    document.getElementById("error").addEventListener("click", function () { closeModal(this); });
    var btn = document.getElementById("btnsubmitconsent");
    if (btn) {
        btn.addEventListener("click", function () { SubmitConsent(submitConsentUrl); });
    }
    document.addEventListener('DOMContentLoaded', function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
    var consentStatementModal = document.getElementById("consentStatementModal");
    if (consentStatementModal) {
        consentStatementModal.addEventListener("shown.bs.modal", MarkConsentDocumentViewed);
    }
</script>
