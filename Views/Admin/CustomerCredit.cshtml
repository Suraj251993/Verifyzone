@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model OrgCheck.ViewModels.CustomerCreditViewModel
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/assets/js/exit-details.js?ver=2" asp-append-version="true"></script>

<div class="breadcrumbs" style="padding: 10px 0px 20px 5px"><a href="/Admin/Index"><i
        class="ri-home-8-line" style="color: var(--purple-color)"></i></a> <i class="ri-arrow-right-s-line"
    style="color: var(--purple-color)"></i> <span
    style="color: var(--purple-color);font-size: 14px;">Admin</span> <i class="ri-arrow-right-s-line"
    style="color: var(--purple-color)"></i> <span style="font-size: 14px;">Customers credit</span>
</div>

<div class="content">
    <h5 class="bulk-table-heading mb-2">Customers credit</h5>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-8">
                    <div class="inputContainer reasonContainer" id="inputContainer" style="position: relative;">
                        <input required="required" autocomplete="off" class="input-container"
                               placeholder="-- Choose customer --" type="text" readonly>
                        <label class="usernameLabel">Choose customer</label>
                        <i class="ri-group-2-line userIcon"></i>
                        <svg viewBox="0 0 320 512" class="chevronIcon" id="chevronIcon">
                            <path d="M143 352.3L7 216.3c-9.4-9.4-9.4-24.6 0-33.9l22.6-22.6c9.4-9.4
                                                        24.6-9.4 33.9 0L160 239.4l96.5-96.5c9.4-9.4
                                                        24.6-9.4 33.9 0l22.6 22.6c9.4 9.4
                                                        9.4 24.6 0 33.9l-136 136c-9.4 9.4-24.6
                                                        9.4-33.9 0z" />
                        </svg>
                        <div id="mddsearchcustomer" class="newinput-dropdown-menu"></div>
                    </div>
                </div>
                <div class="col-md-4 pt-3">
                    <div class="d-flex gap-2">
                        <button class="btn-submit" id="GetCredit">
                            <div class="original">Get Data</div>
                            <div class="letters">
                                <span>G</span>
                                <span>e</span>
                                <span>t</span>
                                <span class="ms-1"></span>
                                <span>D</span>
                                <span>a</span>
                                <span>t</span>
                                <span>a</span>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="d-flex gap-2">                
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex gap-2 justify-content-end pt-4">
                
                <div class="pt-1">
                    <button class="btn-submit border-0" data-bs-toggle="modal" data-bs-target="#adduser"
                            style="background-color: rgb(16, 114, 16);">
                        <div class="original" style="background-color: rgb(16, 114, 16);"> Add Credit</div>
                        <div class="letters" style="background-color: rgb(16, 114, 16);">
                            <span>A</span>
                            <span>d</span>
                            <span>d</span>
                            <span class="ms-1"></span>
                            <span>C</span>
                            <span>r</span>
                            <span>e</span>
                            <span>d</span>
                            <span>i</span>
                            <span>t</span>
                        </div>
                    </button>
                </div>
            </div>

        </div>
    </div>

    <div class="card p-0 mt-3 mb-4 border-0">
        <table>
            <thead style="background: #f8ece2">
                <tr>
                    <th class="sortable">
                        Customer name <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Credit(s) <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Transaction type <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Reference <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                    <th class="sortable">
                        Credit Date <i class="ri-arrow-down-line"></i><i class="ri-arrow-up-line d-none"></i>
                    </th>
                </tr>
            </thead>

            <tbody class="tbody-tr tbodyTr" id="tableIdx">
            </tbody>
        </table>
    </div>
    
    <div class="modal fade" id="adduser" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
         aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h1 class="bulk-table-heading modal-title fs-5" id="staticBackdropLabel">
                        Add customer credit
                    </h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="inputContainer reasonContainer" id="inputContainer"
                                 style="position: relative;">
                                <input required="required" autocomplete="off" class="input-container"
                                       placeholder="-- Choose customer name --" type="text" readonly>
                                <label class="usernameLabel">Choose customer name</label>
                                <i class="ri-group-2-line userIcon"></i>
                                <svg viewBox="0 0 320 512" class="chevronIcon" id="chevronIcon">
                                    <path d="M143 352.3L7 216.3c-9.4-9.4-9.4-24.6 0-33.9l22.6-22.6c9.4-9.4
                                                        24.6-9.4 33.9 0L160 239.4l96.5-96.5c9.4-9.4
                                                        24.6-9.4 33.9 0l22.6 22.6c9.4 9.4
                                                        9.4 24.6 0 33.9l-136 136c-9.4 9.4-24.6
                                                        9.4-33.9 0z" />
                                </svg>
                                <div id="dropdownCustomerMenu" class="newinput-dropdown-menu"></div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="inputContainer">
                                @Html.TextBoxFor(model => model.Credit, new { @class = "input-container", @type = "text", @placeholder = "Please enter credit(s)", @autocomplete = "off", @required = "required" })
                                <label class="usernameLabel">Credit(s)</label>
                                <i class="ri-medal-2-line userIcon"></i>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="inputContainer">
                                @Html.TextBoxFor(model => model.Transactiontype, new { @class = "input-container", @type = "text", @placeholder = "Transaction type", @autocomplete = "off", @required = "required" })
                                <label class="usernameLabel">Transaction type</label>
                                <i class="ri-install-line userIcon"></i>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="inputContainer">
                                @Html.TextBoxFor(model => model.Referenceno, new { @class = "input-container", @type = "text", @placeholder = "Reference no.", @autocomplete = "off" })
                                <label class="usernameLabel">Reference number</label>
                                <i class="ri-list-ordered-2 userIcon"></i>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="inputContainer">
                                @Html.TextBoxFor(model => model.Remarks, new { @class = "input-container", @type = "text", @placeholder = "Remarks", @autocomplete = "off" })
                                <label class="usernameLabel">Remarks</label>
                                <i class="ri-edit-line userIcon"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button class="btn-closes border-0" data-bs-dismiss="modal" style="background-color: gray;">
                        <div class="original" style="background-color: gray;">Close</div>
                        <div class="letters" style="background-color: gray;">
                            <span>C</span>
                            <span>l</span>
                            <span>o</span>
                            <span>s</span>
                            <span>e</span>
                        </div>
                    </button>&nbsp;&nbsp;
                    <button class="btn-submit" type="button" name="save" value="Save" id="Save">
                        <div class="original">Save</div>
                        <div class="letters">
                            <span>S</span>
                            <span>a</span>
                            <span>v</span>
                            <span>e</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteuser" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
         aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <!-- <h1 class="modal-title fs-5" id="staticBackdropLabel">Modal title</h1> -->
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <h5 class="logout-popup-dahx-icon"><i class="ri-delete-bin-7-line"></i></h5>
                    <h6 class="logout-popup-dahx">
                        Are you sure <br>
                        You want to delete the data ?
                    </h6>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button class="btn-closes" data-bs-dismiss="modal">
                        <div class="original">No</div>
                        <div class="letters">
                            <span>N</span>
                            <span>o</span>
                        </div>
                    </button>&nbsp;&nbsp;
                    <button class="btn-submit" type="button" name="next">
                        <div class="original">Yes</div>
                        <div class="letters">
                            <span>Y</span>
                            <span>e</span>
                            <span>s</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="~/assets/js/sort.js" asp-append-version="true"></script>
<script src="~/assets/js/pages/admincuscredit.js" asp-append-version="true"></script>
<script nonce="@ViewContext.HttpContext.Items["CSPNonce"]">
    $(function () {
        var saveurl = '@Url.Action("AddCustomerCredit", "Admin")';
        var searchurl = '@Url.Action("GetCustomers", "Admin")';
        var bindurl = '@Url.Action("GetCustomerCredits", "Admin")';
        document.getElementById("Save").addEventListener("click", function() { SaveCustomerCredit(saveurl); }, false);
        document.getElementById("GetCredit").addEventListener("click", function() { BindCredits(bindurl); }, false);
                
        // Show loader overlay
        const overlay = document.getElementById("formLoaderOverlay");
        overlay.style.display = "none";
        BindSearchCustomers(searchurl);
        BindCustomers(searchurl);               

        document.addEventListener("click", function (e) {
            const link = e.target.closest(".page-link-custom");
            if (!link) return;

            e.preventDefault();

            const page = parseInt(link.dataset.page);
            if (!isNaN(page)) {
                changePage(page);
            }
        });
    });
</script>